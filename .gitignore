/plans/

# Приватный ключ подписи обновлений. Живёт ВНЕ репозитория (~/.z2k-signing/),
# и это единственное правильное место: смысл подписи в том, что захвативший
# репозиторий её не получает. Правила ниже — страховка на случай, если ключ
# по ошибке скопируют внутрь дерева.
*.key
z2k-signing/
.z2k-signing/

# Линтер JavaScript ставится только для проверок и в поставку не идёт.
# package.json/package-lock.json в репозитории ЕСТЬ намеренно: они фиксируют
# версию линтера, иначе вердикт CI начинает зависеть от даты прогона.
node_modules/

# Local-only design specs/plans (superpowers)
docs/superpowers/
