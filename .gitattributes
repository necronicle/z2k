# Force LF line endings for all shell scripts and text files deployed to Linux/router
*.sh text eol=lf
*.lua text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.md text eol=lf
*.py text eol=lf
*.go text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.service text eol=lf
*.timer text eol=lf
