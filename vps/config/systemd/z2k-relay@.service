[Unit]
Description=z2k tunnel relay (%i)
After=network-online.target
Wants=network-online.target

[Service]
# Секреты и порт админки экземпляра — файлами с правами 600, не в командной строке.
EnvironmentFile=/etc/z2k/secrets.env
EnvironmentFile=/etc/z2k/relay-%i.env
ExecStart=/usr/local/bin/z2k-vps-relay --instance=%i --listen=127.0.0.1:${Z2K_PLAIN_PORT} --tls-listen=127.0.0.1:8445 --acme-host=213.176.74.63.nip.io --acme-cache=/var/lib/z2k-relay/acme --secret=env:Z2K_SECRET --secret-prev=env:Z2K_SECRET_PREV --resolve-secret=env:Z2K_RESOLVE_SECRET --registry-path=/var/lib/z2k-relay/registry.json --dial-limit-per-target=32 --dial-throttle-timeout=3s --per-stream-queue-bytes=2097152 --session-queue-bytes=25165824 --session-queue-depth=1024 --control-queue-depth=256 --dial-stats-interval=30s --extra-cidrs=168.119.95.238/32 --require-per-install --admin-addr=127.0.0.1:${Z2K_ADMIN_PORT} --admin-token=env:Z2K_ADMIN_TOKEN --install-snapshot-interval=10m --events-dir=/var/log/z2k-relay --asn-table=/var/lib/z2k-relay/ip2asn-v4.tsv
Restart=always
RestartSec=2
User=nobody
Group=nogroup
# Под ProtectSystem=strict писать можно только сюда: реестр, кеш ACME, события.
StateDirectory=z2k-relay
LogsDirectory=z2k-relay
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Плавная остановка: RETRY_AFTER клиентам v2 и до 90 с ожидания (--drain-timeout).
TimeoutStopSec=120
Environment=GOMEMLIMIT=1500MiB
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
