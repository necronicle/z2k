#!/bin/sh
export PATH=/opt/sbin:/opt/bin:/sbin:/usr/sbin:/bin:/usr/bin

# /opt/etc/init.d/S97z2k-http-tunnel
#
# Spins up a second tg-mtproxy-client instance on :1444 and iptables-redirects
# specific HTTP/80 destinations through it. Coexists with S98tg-tunnel
# (which owns :1443 and the Telegram CIDRs) — different listen port, different
# CIDR list, separate PID file.
#
# Installed by lib/install.sh from files/init.d/S97z2k-http-tunnel.
# Companion NDM hook /opt/etc/ndm/netfilter.d/91-z2k-http-tunnel-redirect.sh
# re-inserts these REDIRECT rules after every NDM-driven netfilter regen
# (WAN flap, tunnel up/down, hotplug, reboot).

BIN="/opt/sbin/tg-mtproxy-client"
LOG="/tmp/z2k-log/z2k-http-tunnel.log"
# CWE-59: root-owned 0700 log dir
# CWE-59: /tmp/z2k-log должен быть чистым root-owned каталогом. symlink /
# не-каталог / чужой владелец = возможная подмена атакующим (с planted
# symlink'ами внутри) → снести и создать заново. busybox `stat -c` нет —
# владельца берём из `ls -ld`.
if [ -L /tmp/z2k-log ] || { [ -e /tmp/z2k-log ] && [ ! -d /tmp/z2k-log ]; } || \
   { [ -d /tmp/z2k-log ] && [ "$(ls -ld /tmp/z2k-log 2>/dev/null | awk '{print $3}')" != root ]; }; then
    rm -rf /tmp/z2k-log 2>/dev/null
fi
mkdir -p /tmp/z2k-log 2>/dev/null && chown root /tmp/z2k-log 2>/dev/null
chmod 700 /tmp/z2k-log 2>/dev/null
PIDFILE="/var/run/z2k-http-tunnel.pid"
LISTEN_PORT="1444"

CIDRS="168.119.95.238/32"

start() {
    [ -x "$BIN" ] || exit 0
    if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE 2>/dev/null)" 2>/dev/null; then
        echo "z2k-http-tunnel already running (pid $(cat $PIDFILE))"
        return 0
    fi
    echo "Starting z2k-http-tunnel on :$LISTEN_PORT..."
    # Proper daemonization: subshell ignores SIGHUP, then exec replaces it
    # with the daemon which inherits the ignored-HUP disposition; stdin
    # is closed so daemon has no controlling tty. Without this, busybox
    # sh on MIPS posts SIGHUP to bg children when init.d wrapper exits,
    # and the Go runtime (terminate-on-HUP by default) kills the daemon
    # before it even reaches "listening on :NNNN" in the log — observed
    # field-debug 2026-05-23 on a Keenetic MIPS user where the same
    # binary ran fine in foreground but died instantly under init.d.
    ( trap '' HUP; exec $BIN --listen=:$LISTEN_PORT --timeout=15m </dev/null >> "$LOG" 2>&1 ) &
    echo $! > "$PIDFILE"
    sleep 2
    for cidr in $CIDRS; do
        iptables -t nat -C PREROUTING -d "$cidr" -p tcp --dport 80 -j REDIRECT --to-port $LISTEN_PORT 2>/dev/null || \
            iptables -t nat -I PREROUTING 1 -d "$cidr" -p tcp --dport 80 -j REDIRECT --to-port $LISTEN_PORT 2>/dev/null
        iptables -t nat -C OUTPUT -d "$cidr" -p tcp --dport 80 -j REDIRECT --to-port $LISTEN_PORT 2>/dev/null || \
            iptables -t nat -I OUTPUT 1 -d "$cidr" -p tcp --dport 80 -j REDIRECT --to-port $LISTEN_PORT 2>/dev/null
    done
    for cidr in $CIDRS; do
        conntrack -D -d "${cidr%/*}" 2>/dev/null || true
    done
}

stop() {
    echo "Stopping z2k-http-tunnel..."
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        # Kill by pid (not killall) — S98tg-tunnel runs the same binary
        # on :1443 and we must not knock it out.
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    for cidr in $CIDRS; do
        while iptables -t nat -C PREROUTING -d "$cidr" -p tcp --dport 80 -j REDIRECT --to-port $LISTEN_PORT 2>/dev/null; do
            iptables -t nat -D PREROUTING -d "$cidr" -p tcp --dport 80 -j REDIRECT --to-port $LISTEN_PORT 2>/dev/null || break
        done
        while iptables -t nat -C OUTPUT -d "$cidr" -p tcp --dport 80 -j REDIRECT --to-port $LISTEN_PORT 2>/dev/null; do
            iptables -t nat -D OUTPUT -d "$cidr" -p tcp --dport 80 -j REDIRECT --to-port $LISTEN_PORT 2>/dev/null || break
        done
    done
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}" ;;
esac
