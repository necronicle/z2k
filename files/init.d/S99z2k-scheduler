#!/bin/sh
# /opt/etc/init.d/S99z2k-scheduler — z2k internal scheduler daemon.
# Replaces Vixie cron for z2k periodic tasks (auto-update / update-lists
# / get_config) because the daemon's reload mechanism is broken on
# Keenetic Entware builds (see r-26 field notes).

SCRIPT="/opt/zapret2/z2k-scheduler.sh"
PIDFILE="/var/run/z2k-scheduler.pid"          # written by the scheduler itself
SUP_PIDFILE="/var/run/z2k-scheduler-sup.pid"  # the respawn supervisor (this script)
LOG="/opt/var/log/z2k-scheduler.log"

# The scheduler process itself (it self-writes $PIDFILE on startup).
is_alive() {
    [ -f "$PIDFILE" ] || return 1
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# The respawn supervisor subshell.
sup_alive() {
    [ -f "$SUP_PIDFILE" ] || return 1
    local pid
    pid=$(cat "$SUP_PIDFILE" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
    if sup_alive; then
        echo "z2k-scheduler supervisor already running (pid $(cat "$SUP_PIDFILE"))"
        return 0
    fi
    [ -x "$SCRIPT" ] || { echo "scheduler script missing or not executable: $SCRIPT" >&2; return 1; }
    mkdir -p "$(dirname "$LOG")" 2>/dev/null

    # Respawn supervisor. The scheduler is the SOLE driver of EVERY periodic z2k
    # task (auto-update, stats upload, list/geosite refresh, get_config, plus the
    # tg-tunnel watchdog and the PPE de-offload re-assert, both ~1/min). These
    # boxes leak RAM and OOM-kill long-lived processes; the previous bare
    # `"$SCRIPT" &` left ALL periodic work dead until the next reboot if the
    # scheduler was killed. Relaunch it whenever it exits, with a short backoff so
    # an instantly-failing script cannot spin. stdin from /dev/null keeps the
    # anti-thundering-herd jitter gate ([ ! -t 0 ]) true under an SSH restart.
    (
        while true; do
            "$SCRIPT" </dev/null >>"$LOG" 2>&1
            _rc=$?
            echo "$(date '+%Y-%m-%d %H:%M:%S') [supervisor] scheduler exited (rc=$_rc) — respawning in 10s" >> "$LOG"
            sleep 10
        done
    # ВАЖНО: подоболочка отвязывается от потоков init-скрипта явно.
    #
    # NDM запускает /opt/etc/init.d/* по очереди и ЧИТАЕТ вывод каждого до конца
    # потока — именно так его строки попадают в системный журнал. Фоновый
    # надзиратель наследует этот поток и держит его открытым всё время жизни, то
    # есть конца не наступает никогда: NDM ждёт и к следующему скрипту не
    # переходит.
    #
    # Замер на роутере: с голым `) &` читатель висит бесконечно, с явным
    # отвязыванием поток закрывается за секунду.
    #
    # Цена этой строки — вся загрузка. У человека из отчёта 2026-08-05 цепочка
    # встала на S96z2k-rt-proxy, и веб-панель, http-туннель, планировщик и сам
    # zapret2 не поднялись вовсе: он ждал двадцать минут и запускал их руками.
    # S51z2k-warp делал это правильно с самого начала, остальные четыре — нет.
    ) >/dev/null 2>&1 </dev/null &
    _sup_pid=$!
    echo "$_sup_pid" > "$SUP_PIDFILE"
    # OOM-protect the supervisor. It is the SOLE recovery path for every periodic
    # z2k task; if it dies nothing respawns it until reboot. These boxes run with
    # swap=0 (no OOM cushion) and have killed supervisor+scheduler together, leaving
    # auto-update dead for days (field 2026-07-06). The supervisor is a tiny shell
    # loop, so making it OOM-immune costs nothing and guarantees it survives to
    # respawn the scheduler. The scheduler resets its own score on startup (it would
    # otherwise inherit -1000), keeping the heavy tasks it fires normal OOM targets.
    echo -1000 > "/proc/$_sup_pid/oom_score_adj" 2>/dev/null || true
    sleep 1
    if sup_alive && is_alive; then
        echo "z2k-scheduler started (supervisor $(cat "$SUP_PIDFILE"), scheduler $(cat "$PIDFILE" 2>/dev/null))"
    else
        echo "z2k-scheduler failed to start" >&2
        return 1
    fi
}

stop() {
    # Kill the supervisor FIRST so it stops respawning the scheduler.
    if sup_alive; then
        local spid
        spid=$(cat "$SUP_PIDFILE")
        kill "$spid" 2>/dev/null
        for _ in 1 2 3; do
            kill -0 "$spid" 2>/dev/null || break
            sleep 1
        done
        kill -0 "$spid" 2>/dev/null && kill -9 "$spid" 2>/dev/null
    fi
    rm -f "$SUP_PIDFILE"

    # Then the scheduler itself — it may be orphaned mid-task now the supervisor
    # is gone. Its TERM trap removes $PIDFILE and exits cleanly.
    if is_alive; then
        local pid
        pid=$(cat "$PIDFILE")
        kill "$pid" 2>/dev/null
        for _ in 1 2 3; do
            kill -0 "$pid" 2>/dev/null || break
            sleep 1
        done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    fi
    rm -f "$PIDFILE"
    # Sweep stragglers matching by cmdline (the init wrapper is S99z2k-scheduler,
    # so this matches only the scheduler.sh process tree, not the supervisor).
    pkill -f "z2k-scheduler\.sh" 2>/dev/null
    echo "z2k-scheduler stopped"
}

status() {
    if sup_alive && is_alive; then
        echo "running (supervisor $(cat "$SUP_PIDFILE"), scheduler $(cat "$PIDFILE"))"
        return 0
    fi
    if sup_alive; then
        echo "supervisor up, scheduler down (respawning)"
        return 0
    fi
    echo "stopped"
    return 1
}

case "${1:-}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
