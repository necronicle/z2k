#!/bin/sh
# Entware init.d минимальный PATH без /opt/bin — flag-check на awk молча
# падает и daemon стартует даже на TG_PROXY_USER_DISABLED=1.
export PATH=/opt/sbin:/opt/bin:/sbin:/usr/sbin:/bin:/usr/bin

# /opt/etc/init.d/S98tg-tunnel — Telegram tunnel init script.
#
# start/stop/restart the tg-mtproxy-client daemon and manage the iptables
# REDIRECT rules that bounce Telegram DC traffic (TCP 443) into the
# locally-bound tunnel at :1443. Inserted at the top of PREROUTING and
# OUTPUT so our rules precede Keenetic's _NDM_* chains.
#
# Installed by lib/install.sh from files/init.d/S98tg-tunnel.
# The NDM netfilter.d hook (/opt/etc/ndm/netfilter.d/90-z2k-tg-redirect.sh)
# re-inserts these rules after every NDM-driven netfilter regen so they
# survive WAN flaps / tunnel up-down / hotplug / reboot.

BIN="/opt/sbin/tg-mtproxy-client"
LOG="/tmp/z2k-log/tg-tunnel.log"
# CWE-59: root-owned 0700 log dir
# CWE-59: /tmp/z2k-log должен быть чистым root-owned каталогом. symlink /
# не-каталог / чужой владелец = возможная подмена атакующим (с planted
# symlink'ами внутри) → снести и создать заново. busybox `stat -c` нет —
# владельца берём из `ls -ld`.
if [ -L /tmp/z2k-log ] || { [ -e /tmp/z2k-log ] && [ ! -d /tmp/z2k-log ]; } || \
   { [ -d /tmp/z2k-log ] && [ "$(ls -ld /tmp/z2k-log 2>/dev/null | awk '{print $3}')" != root ]; }; then
    rm -rf /tmp/z2k-log 2>/dev/null
fi
mkdir -p /tmp/z2k-log 2>/dev/null && chown root /tmp/z2k-log 2>/dev/null
chmod 700 /tmp/z2k-log 2>/dev/null
PIDFILE="/var/run/tg-tunnel.pid"

CIDRS="149.154.160.0/20 91.108.4.0/22 91.108.8.0/22 91.108.12.0/22 91.108.16.0/22 91.108.20.0/22 91.108.56.0/22 91.105.192.0/23 95.161.64.0/20 185.76.151.0/24"

start() {
    [ -x "$BIN" ] || exit 0
    # Honor TG_PROXY_USER_DISABLED — if user explicitly stopped the tunnel
    # via menu/webpanel, don't autostart on boot (otherwise it'd come back
    # every reboot and stay up until the watchdog cron fires ~60s later).
    if [ -f "/opt/zapret2/config" ]; then
        user_disabled=$(awk -F= '/^TG_PROXY_USER_DISABLED=/ {gsub(/[" ]/,"",$2); print $2; exit}' /opt/zapret2/config)
        if [ "$user_disabled" = "1" ]; then
            echo "tg-tunnel disabled by user — skipping autostart"
            return 0
        fi
    fi
    # Per-instance check — match by cmdline so we don't get false-positive
    # from the S97z2k-http-tunnel sibling (same binary, --listen=:1444).
    if pidof tg-mtproxy-client >/dev/null 2>&1; then
        for p in $(pidof tg-mtproxy-client); do
            if [ -r "/proc/$p/cmdline" ] && tr '\0' ' ' < "/proc/$p/cmdline" | grep -q -- "--listen=:1443"; then
                echo "tg-tunnel already running (pid $p)"
                return 0
            fi
        done
    fi
    echo "Starting tg-tunnel supervisor..."
    # SUPERVISOR loop (s6/runit pattern in shell — Entware has no systemd/procd).
    # The pidfile holds the SUPERVISOR (parent of the daemon); it respawns the
    # daemon on exit with capped backoff so a transient relay drop can't leave
    # Telegram tunneling dead until a manual restart. Same proven pattern as
    # S97z2k-http-tunnel.
    #   trap '' HUP   — MIPS busybox SIGHUP fix: the daemon child inherits the
    #                   ignored-HUP disposition (Go terminates on HUP by default;
    #                   busybox posts HUP to bg children when the wrapper exits).
    #   trap TERM/INT — `stop` kills the supervisor; the trap kills the daemon.
    #   backoff resets after a healthy run (>=60s), else grows to a 30s cap.
    (
        trap '' HUP
        trap 'kill "$child" 2>/dev/null; exit 0' TERM INT
        backoff=1
        while :; do
            t0=$(date +%s 2>/dev/null || echo 0)
            $BIN --listen=:1443 --timeout=15m -v </dev/null >> "$LOG" 2>&1 &
            child=$!
            wait "$child"
            t1=$(date +%s 2>/dev/null || echo 0)
            if [ $((t1 - t0)) -ge 60 ]; then
                backoff=1
            else
                backoff=$((backoff * 2)); [ "$backoff" -gt 30 ] && backoff=30
            fi
            echo "$(date 2>/dev/null) [supervisor] daemon exited, respawn in ${backoff}s" >> "$LOG"
            sleep "$backoff"
        done
    ) &
    echo $! > "$PIDFILE"
    sleep 2
    # Insert REDIRECT rules at TOP of both PREROUTING and OUTPUT (-I 1) so
    # they precede Keenetic's _NDM_* chains. PREROUTING catches forwarded
    # traffic from LAN clients; OUTPUT catches locally-originated traffic
    # from the router itself (e.g. the watchdog probe).
    for cidr in $CIDRS; do
        iptables -t nat -C PREROUTING -d "$cidr" -p tcp --dport 443 -j REDIRECT --to-port 1443 2>/dev/null || \
            iptables -t nat -I PREROUTING 1 -d "$cidr" -p tcp --dport 443 -j REDIRECT --to-port 1443 2>/dev/null
        iptables -t nat -C OUTPUT -d "$cidr" -p tcp --dport 443 -j REDIRECT --to-port 1443 2>/dev/null || \
            iptables -t nat -I OUTPUT 1 -d "$cidr" -p tcp --dport 443 -j REDIRECT --to-port 1443 2>/dev/null
    done
    # Flush stale conntrack entries so Android/iOS Telegram clients
    # immediately create new connections through the REDIRECT path
    # instead of riding stale direct-to-DC entries from before the
    # tunnel was (re)started.
    for cidr in $CIDRS; do
        conntrack -D -d "$cidr" 2>/dev/null || true
    done
}

stop() {
    echo "Stopping tg-tunnel..."
    # Kill by PID — a sibling instance (S97z2k-http-tunnel on :1444) runs
    # the same binary, so killall would knock it out as collateral damage.
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
    fi
    # Fallback: find a tg-mtproxy-client listening on :1443 and only kill that one.
    if pidof tg-mtproxy-client >/dev/null 2>&1; then
        for p in $(pidof tg-mtproxy-client); do
            if [ -r "/proc/$p/cmdline" ] && tr '\0' ' ' < "/proc/$p/cmdline" | grep -q -- "--listen=:1443"; then
                kill "$p" 2>/dev/null
            fi
        done
    fi
    rm -f "$PIDFILE"
    # Idempotent removal: drop every matching copy of the rule from both chains.
    for cidr in $CIDRS; do
        while iptables -t nat -C PREROUTING -d "$cidr" -p tcp --dport 443 -j REDIRECT --to-port 1443 2>/dev/null; do
            iptables -t nat -D PREROUTING -d "$cidr" -p tcp --dport 443 -j REDIRECT --to-port 1443 2>/dev/null || break
        done
        while iptables -t nat -C OUTPUT -d "$cidr" -p tcp --dport 443 -j REDIRECT --to-port 1443 2>/dev/null; do
            iptables -t nat -D OUTPUT -d "$cidr" -p tcp --dport 443 -j REDIRECT --to-port 1443 2>/dev/null || break
        done
    done
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}" ;;
esac
