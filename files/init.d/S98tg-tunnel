#!/bin/sh
# Entware init.d минимальный PATH без /opt/bin — flag-check на awk молча
# падает и daemon стартует даже на TG_PROXY_USER_DISABLED=1.
export PATH=/opt/sbin:/opt/bin:/sbin:/usr/sbin:/bin:/usr/bin

# TLS trust for the relay. The client is Go and Go uses the SYSTEM store, which on a
# Keenetic is whatever the firmware happens to ship plus whatever opkg's ca-certificates
# left behind. On routers where neither carries ISRG Root X1 the tunnel dies forever with
#     tls: failed to verify certificate: x509: certificate signed by unknown authority
# and the standing advice — `opkg install ca-certificates` — stops working the moment opkg
# itself is broken, which is exactly the state those routers tend to be in.
#
# So point Go at anchors we ship (SSL_CERT_FILE) AND at the firmware's directory
# (SSL_CERT_DIR) — Go merges both, so this adds trust without taking any away. Each is set
# only if it actually exists: an SSL_CERT_FILE pointing at a missing file would empty the
# pool and break TLS on a router where it currently works.
[ -f /opt/zapret2/etc/z2k-roots.pem ] && export SSL_CERT_FILE=/opt/zapret2/etc/z2k-roots.pem
[ -d /etc/ssl/certs ] && export SSL_CERT_DIR=/etc/ssl/certs

# /opt/etc/init.d/S98tg-tunnel — Telegram tunnel init script.
#
# start/stop/restart the tg-mtproxy-client daemon and manage the iptables
# REDIRECT rules that bounce Telegram DC traffic (TCP 443) into the
# locally-bound tunnel at :1443. Inserted at the top of PREROUTING and
# OUTPUT so our rules precede Keenetic's _NDM_* chains.
#
# Installed by lib/install.sh from files/init.d/S98tg-tunnel.
# The NDM netfilter.d hook (/opt/etc/ndm/netfilter.d/90-z2k-tg-redirect.sh)
# re-inserts these rules after every NDM-driven netfilter regen so they
# survive WAN flaps / tunnel up-down / hotplug / reboot.

BIN="/opt/sbin/tg-mtproxy-client"
LOG="/tmp/z2k-log/tg-tunnel.log"
# CWE-59: root-owned 0700 log dir
# CWE-59: /tmp/z2k-log должен быть чистым root-owned каталогом. symlink /
# не-каталог / чужой владелец = возможная подмена атакующим (с planted
# symlink'ами внутри) → снести и создать заново. busybox `stat -c` нет —
# владельца берём из `ls -ld`.
if [ -L /tmp/z2k-log ] || { [ -e /tmp/z2k-log ] && [ ! -d /tmp/z2k-log ]; } || \
   { [ -d /tmp/z2k-log ] && [ "$(ls -ld /tmp/z2k-log 2>/dev/null | awk '{print $3}')" != root ]; }; then
    rm -rf /tmp/z2k-log 2>/dev/null
fi
mkdir -p /tmp/z2k-log 2>/dev/null && chown root /tmp/z2k-log 2>/dev/null
chmod 700 /tmp/z2k-log 2>/dev/null
PIDFILE="/var/run/tg-tunnel.pid"
# Поколение надзирателя. Пишется ПЕРЕД запуском подоболочки; подоболочка на
# каждом круге сверяет его со своим и уходит, если поколение сменилось. Так
# лишний надзиратель умирает сам, не дожидаясь перезагрузки.
GENFILE="/var/run/tg-tunnel.gen"

# Telegram-DC redirect helpers (ipset + -w-locked rules). Single source of
# truth shared with the NDM hook (90-z2k-tg-redirect.sh) and the tg-watchdog.
TG_REDIR_LIB="/opt/zapret2/z2k-tg-redirect.sh"
[ -r "$TG_REDIR_LIB" ] && . "$TG_REDIR_LIB"

start() {
    [ -x "$BIN" ] || exit 0
    # Honor TG_PROXY_USER_DISABLED — if user explicitly stopped the tunnel
    # via menu/webpanel, don't autostart on boot (otherwise it'd come back
    # every reboot and stay up until the watchdog cron fires ~60s later).
    if [ -f "/opt/zapret2/config" ]; then
        user_disabled=$(awk -F= '/^TG_PROXY_USER_DISABLED=/ {gsub(/[" ]/,"",$2); print $2; exit}' /opt/zapret2/config)
        if [ "$user_disabled" = "1" ]; then
            echo "tg-tunnel disabled by user — skipping autostart"
            return 0
        fi
    fi
    # ЖИВОЙ НАДЗИРАТЕЛЬ — ВТОРОЙ НЕ НУЖЕН.
    #
    # Проверка ниже смотрит на ДЕМОНА, и этого мало: надзиратель между
    # перезапусками спит до 30 с, и в этот момент демона нет вовсе. Любой
    # параллельный `start` (сторож раз в минуту, автообновление, хук NDM,
    # кнопка в панели) проходил проверку и поднимал ВТОРОГО надзирателя.
    # Дальше два цикла дерутся за :1443: один держит порт, второй каждые 30 с
    # родит демона, тот падает с «bind: address already in use» и умирает.
    # Вечный форк-цикл, туннель при этом работает — поэтому никто не замечал.
    # Найдено на роутере Марка 05.09.2026: два надзирателя, 182 круга в логе.
    #
    # У S96z2k-rt-proxy, S97z2k-http-tunnel и S99z2k-scheduler такая проверка
    # была с самого начала; здесь её не было.
    if [ -f "$PIDFILE" ]; then
        _sup=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$_sup" ] && kill -0 "$_sup" 2>/dev/null && \
           [ -r "/proc/$_sup/cmdline" ] && \
           tr '\0' ' ' < "/proc/$_sup/cmdline" 2>/dev/null | grep -q "S98tg-tunnel"; then
            echo "tg-tunnel supervisor already running (pid $_sup)"
            return 0
        fi
    fi
    # Per-instance check — match by cmdline so we don't get false-positive
    # from the S97z2k-http-tunnel sibling (same binary, --listen=:1444).
    if pidof tg-mtproxy-client >/dev/null 2>&1; then
        for p in $(pidof tg-mtproxy-client); do
            if [ -r "/proc/$p/cmdline" ] && tr '\0' ' ' < "/proc/$p/cmdline" | grep -q -- "--listen=:1443"; then
                echo "tg-tunnel already running (pid $p)"
                return 0
            fi
        done
    fi
    echo "Starting tg-tunnel supervisor..."
    # SUPERVISOR loop (s6/runit pattern in shell — Entware has no systemd/procd).
    # The pidfile holds the SUPERVISOR (parent of the daemon); it respawns the
    # daemon on exit with capped backoff so a transient relay drop can't leave
    # Telegram tunneling dead until a manual restart. Same proven pattern as
    # S97z2k-http-tunnel.
    #   trap '' HUP   — MIPS busybox SIGHUP fix: the daemon child inherits the
    #                   ignored-HUP disposition (Go terminates on HUP by default;
    #                   busybox posts HUP to bg children when the wrapper exits).
    #   trap TERM/INT — `stop` kills the supervisor; the trap kills the daemon.
    #   backoff resets after a healthy run (>=60s), else grows to a 30s cap.
    # Optional per-install overrides from /opt/zapret2/config: a relay secret/URL
    # set there takes precedence over the binary's build-injected defaults — lets
    # us rotate the tunnel secret or repoint the relay without rebuilding the
    # client. Absent (the normal case) => the compiled-in default is used.
    TUNNEL_FLAGS=""
    if [ -f "/opt/zapret2/config" ]; then
        _rs=$(awk -F= '/^Z2K_RELAY_SECRET=/ {gsub(/[" ]/,"",$2); print $2; exit}' /opt/zapret2/config)
        _ru=$(awk -F= '/^Z2K_RELAY_URL=/ {gsub(/[" ]/,"",$2); print $2; exit}' /opt/zapret2/config)
        [ -n "$_rs" ] && TUNNEL_FLAGS="$TUNNEL_FLAGS --tunnel-secret=$_rs"
        [ -n "$_ru" ] && TUNNEL_FLAGS="$TUNNEL_FLAGS --tunnel-url=$_ru"
    fi
    _sup_gen="$(date +%s 2>/dev/null || echo 0).$$"
    echo "$_sup_gen" > "$GENFILE" 2>/dev/null
    (
        trap '' HUP
        trap 'kill "$child" 2>/dev/null; exit 0' TERM INT
        backoff=1
        while :; do
            # Сменилось поколение — значит нас уже заменили. Уходим сами, не
            # дожидаясь, пока кто-то найдёт и убьёт. Проверка стоит В НАЧАЛЕ
            # круга, поэтому уснувший в backoff дубликат уходит сразу после
            # пробуждения, а не рожает ещё одного обречённого демона.
            if [ "$(cat "$GENFILE" 2>/dev/null)" != "$_sup_gen" ]; then
                echo "$(date 2>/dev/null) [supervisor] поколение сменилось — выхожу (дубликат)" >> "$LOG"
                exit 0
            fi
            t0=$(date +%s 2>/dev/null || echo 0)
            # GODEBUG=asyncpreemptoff=1: disable Go's SIGURG-based async goroutine
            # preemption. On MIPS (softfloat Keenetics) it crashes the client with
            # `fatal error: index out of range` in runtime.isAsyncSafePoint ->
            # funcName (a bad preempted PC indexes the functab out of bounds); the
            # supervisor respawns it and it crash-loops, so the bypass "stops by
            # itself". Disabling async preempt removes that code path; for an I/O
            # client (constant safe points) it has no functional cost. Harmless on
            # non-MIPS arches, so set unconditionally.
            # shellcheck disable=SC2086  # TUNNEL_FLAGS is intentionally word-split
            GODEBUG=asyncpreemptoff=1 $BIN --listen=:1443 --timeout=15m $TUNNEL_FLAGS -v </dev/null >> "$LOG" 2>&1 &
            child=$!
            wait "$child"
            t1=$(date +%s 2>/dev/null || echo 0)
            if [ $((t1 - t0)) -ge 60 ]; then
                backoff=1
            else
                backoff=$((backoff * 2)); [ "$backoff" -gt 30 ] && backoff=30
            fi
            echo "$(date 2>/dev/null) [supervisor] daemon exited, respawn in ${backoff}s" >> "$LOG"
            sleep "$backoff"
        done
    # ВАЖНО: подоболочка отвязывается от потоков init-скрипта явно.
    #
    # NDM запускает /opt/etc/init.d/* по очереди и ЧИТАЕТ вывод каждого до конца
    # потока — именно так его строки попадают в системный журнал. Фоновый
    # надзиратель наследует этот поток и держит его открытым всё время жизни, то
    # есть конца не наступает никогда: NDM ждёт и к следующему скрипту не
    # переходит.
    #
    # Замер на роутере: с голым `) &` читатель висит бесконечно, с явным
    # отвязыванием поток закрывается за секунду.
    #
    # Цена этой строки — вся загрузка. У человека из отчёта 2026-08-05 цепочка
    # встала на S96z2k-rt-proxy, и веб-панель, http-туннель, планировщик и сам
    # zapret2 не поднялись вовсе: он ждал двадцать минут и запускал их руками.
    # S51z2k-warp делал это правильно с самого начала, остальные четыре — нет.
    ) >/dev/null 2>&1 </dev/null &
    echo $! > "$PIDFILE"
    sleep 2
    # Insert REDIRECT rules at TOP of both PREROUTING and OUTPUT (-I 1) so
    # they precede Keenetic's _NDM_* chains. PREROUTING catches forwarded
    # traffic from LAN clients; OUTPUT catches locally-originated traffic
    # from the router itself (e.g. the watchdog probe).
    z2k_tg_remove_legacy_rules   # migrate off pre-ipset per-CIDR rules on (re)start
    z2k_tg_ensure_rules          # ipset + 2 REDIRECT rules, -w-locked, verify-retry
    # Flush stale conntrack so Android/iOS Telegram clients immediately create
    # new connections through the REDIRECT path instead of riding stale
    # direct-to-DC entries from before the tunnel (re)started.
    z2k_tg_flush_conntrack
}

stop() {
    echo "Stopping tg-tunnel..."
    # Kill by PID — a sibling instance (S97z2k-http-tunnel on :1444) runs
    # the same binary, so killall would knock it out as collateral damage.
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
    fi
    # Fallback: find a tg-mtproxy-client listening on :1443 and only kill that one.
    if pidof tg-mtproxy-client >/dev/null 2>&1; then
        for p in $(pidof tg-mtproxy-client); do
            if [ -r "/proc/$p/cmdline" ] && tr '\0' ' ' < "/proc/$p/cmdline" | grep -q -- "--listen=:1443"; then
                kill "$p" 2>/dev/null
            fi
        done
    fi
    rm -f "$PIDFILE" "$GENFILE"
    # ОСИРОТЕВШИЕ НАДЗИРАТЕЛИ. До правки 05.09.2026 их могло накопиться
    # несколько, и в pidfile лежал только последний — остальные переживали
    # `stop` и продолжали поднимать демона. Добиваем всех: подоболочка после
    # отвязывания висит на ppid=1, а сам работающий сейчас скрипт исключаем
    # по $$, иначе `restart` убил бы сам себя посреди работы.
    for _pd in /proc/[0-9]*; do
        p="${_pd#/proc/}"
        [ "$p" = "$$" ] && continue
        [ -r "$_pd/cmdline" ] || continue
        tr '\0' ' ' < "$_pd/cmdline" 2>/dev/null | grep -q "S98tg-tunnel" || continue
        [ "$(awk '/^PPid:/{print $2}' "$_pd/status" 2>/dev/null)" = "1" ] || continue
        kill "$p" 2>/dev/null
    done
    # Idempotent removal: drop every matching copy of the rule from both chains.
    z2k_tg_remove_rules          # remove the ipset REDIRECT rules
    z2k_tg_remove_legacy_rules   # and any stale pre-ipset per-CIDR rules
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}" ;;
esac
