#!/bin/sh
# /opt/etc/init.d/S51z2k-warp — z2k's OWN lifecycle for the Cloudflare WARP (MASQUE) tunnel.
#
# Replaces the usque-keenetic package's S51usque entirely. The ENGINE stays upstream's
# `usque` binary — that part is healthy and actively developed. What we take over is the
# lifecycle, because every WARP failure we chased lived there, not in the engine:
#
#   * usque.conf.run overrode usque.conf and was only cleared while the daemon was alive,
#     so a crashed daemon pinned the old address forever and config edits never applied;
#   * fn_stop returned early when the daemon was already dead, leaving that file behind;
#   * fn_is_running compared a pidfile against pgrep and lost track of its own daemon;
#   * the interface name was "first free opkgtunN", so a leftover interface silently moved
#     the real tunnel to opkgtun1 while everything else still pointed at opkgtun0;
#   * fn_setup_tun_interface configured the NDM interface before usque had created the tun
#     netdev — a race we were patching in THEIR script with sed on every single install.
#
# Design here, deliberately boring and matching S96z2k-rt-proxy:
#   * one supervisor subshell owns the daemon and respawns it with capped backoff;
#   * the pidfile holds the SUPERVISOR, and liveness is `kill -0`, not name matching;
#   * NDM configuration happens only AFTER the tun netdev exists — no race, no sed;
#   * the interface name and address are chosen once, recorded, and reused — no lottery;
#   * an address already owned by another interface is stepped over, because NDM refuses
#     to raise an interface onto a conflicting network and the tunnel then never comes up.

PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/sbin:/usr/sbin:/bin:/usr/bin
export PATH

NAME="z2k-warp"
BIN="${BIN:-/opt/sbin/z2k-usque}"
# OUTSIDE /opt/zapret2 on purpose: a reinstall replaces that tree wholesale, which would burn
# the WARP device key on every update and drop a working tunnel.
WARP_DIR="${WARP_DIR:-/opt/etc/z2k-warp}"
WARP_DIR_LEGACY="${WARP_DIR_LEGACY:-/opt/zapret2/warp}"
SESSION="${SESSION:-$WARP_DIR/session.conf}"
STATE_IFACE="${STATE_IFACE:-$WARP_DIR/iface}"      # remembered netdev name (opkgtunN)
STATE_ADDR="${STATE_ADDR:-$WARP_DIR/addr}"         # remembered local address
PIDFILE="${PIDFILE:-/var/run/z2k-warp.pid}"
LOG="${LOG:-/tmp/z2k-log/z2k-warp.log}"
SNI="${SNI:-ozon.ru}"                              # outer TLS SNI (domain fronting)
MTU="${MTU:-1280}"
# EMERGENCY FALLBACK POOL ONLY — not the address we normally use. iface_addr takes the
# address WARP itself assigned (session.conf "ipv4") and only scans this pool when that
# one is genuinely held by another interface.
#
# History, because the old comment here outlived its reason and reads like a live
# requirement: 172.16.240 was chosen when the usque-keenetic PACKAGE owned the tunnel and
# auto-picked its IFACE_IP from 172.16.1.100-200, colliding with Keenetic's built-in
# SSTP/L2TP servers on 172.16.1.x (d6bc05f). Commit b5cf5af dropped that package and moved
# the tunnel here, so nothing auto-picks from 172.16.1.x any more — the collision that
# justified the pin no longer exists, and WARP's own address (172.16.0.2 on both routers
# checked) is not in that pool anyway. Addresses are applied as /32, so only an exact
# match can clash, never an overlapping range.
ADDR_NET="${ADDR_NET:-172.16.240}"
KEEPALIVE="${KEEPALIVE:-25s}"                      # usque -k; CF drops an idle MASQUE session

# Legacy package paths — read ONLY to migrate away from them.
PKG_INIT="/opt/etc/init.d/S51usque"
PKG_SESSION="/opt/etc/usque/session.conf"

mkdir -p "$WARP_DIR" "$(dirname "$LOG")" 2>/dev/null

log() { echo "$(date 2>/dev/null) [$NAME] $*" >> "$LOG"; }

ndm() { LD_LIBRARY_PATH= ndmc -c "$1" >/dev/null 2>&1; }

# netdev name -> NDM interface name (opkgtun1 -> OpkgTun1), mirroring Keenetic's convention.
ndm_name() { echo "$1" | sed 's/^opkg/Opkg/; s/tun/Tun/'; }

# ---- interface identity (chosen ONCE, then reused) ---------------------------
# The package re-derived "first free opkgtunN" on every install, which is how a leftover
# interface silently relocated the tunnel. We pick once, record it, and keep using it.
pick_iface() {
    local n=0 name
    while [ "$n" -lt 16 ]; do
        name="opkgtun$n"
        ip link show "$name" >/dev/null 2>&1 || { echo "$name"; return 0; }
        n=$((n + 1))
    done
    echo "opkgtun0"
}

iface_name() {
    local i
    i=$(cat "$STATE_IFACE" 2>/dev/null)
    case "$i" in opkgtun[0-9]*) echo "$i"; return 0 ;; esac
    # First run: adopt the interface the usque PACKAGE created for us, so an upgrade keeps the
    # user's existing NDM object instead of piling up another one. Adopt ONLY that one: other
    # opkgtunN devices belong to other Entware tunnels (sing-box, xray, AmneziaWG), and taking
    # one over would reconfigure a stranger's tunnel, save it into startup-config, and drop it
    # on our stop(). An unproven interface is not ours.
    i=$(grep -m1 '^IFACE=' /opt/etc/usque/usque.conf 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d ' ')
    case "$i" in
        opkgtun[0-9]*)
            if ip link show "$i" >/dev/null 2>&1; then
                echo "$i" > "$STATE_IFACE" 2>/dev/null
                echo "$i"; return 0
            fi ;;
    esac
    i=$(pick_iface); echo "$i" > "$STATE_IFACE" 2>/dev/null; echo "$i"
}

# Is $1 held by an interface OTHER than ours? NDM refuses to raise an interface onto an
# address another one already owns ("network X conflicts with interface Y"), and the tunnel
# then never comes up — silently.
addr_taken_by_other() {
    ip -o -4 addr show 2>/dev/null | awk -v ifc="$2" -v want="$1" '
        $2 != ifc { sub(/\/.*/, "", $4); if ($4 == want) found = 1 }
        END { exit !found }'
}

# The address WARP itself handed this device, read out of the device config. usque
# proxies IP PACKETS: Cloudflare sees the inner source address, and one it never
# assigned is not guaranteed to be carried. We used to invent an address from
# $ADDR_NET instead — measured on two routers, session.conf said 172.16.0.2 while
# the interface carried 172.16.240.1 on both. The 172.16.240.x pin exists to dodge
# Keenetic's SSTP/L2TP 172.16.1.x pool that the OLD usque package auto-picked from — a
# collision that died with the package (see ADDR_NET above) — and dodging it by using a
# DIFFERENT address than the tunnel was given traded one breakage for another.
session_addr() {
    [ -s "$SESSION" ] || return 1
    sed -n 's/.*"ipv4"[[:space:]]*:[[:space:]]*"\([0-9][0-9.]*\)".*/\1/p' "$SESSION" 2>/dev/null | head -1
}

iface_addr() {
    local ifc="$1" a n
    # WARP's own address first.
    a=$(session_addr)
    case "$a" in
        [0-9]*.[0-9]*.[0-9]*.[0-9]*)
            if addr_taken_by_other "$a" "$ifc"; then
                # Genuinely collides with another interface. Do NOT silently substitute —
                # say so, because the tunnel will source from an address CF did not assign
                # and the failure looks like "tunnel up but carries nothing".
                log "WARNING: WARP assigned $a but another interface already holds it — falling back to $ADDR_NET.x; traffic may not be carried"
            else
                echo "$a" > "$STATE_ADDR" 2>/dev/null
                echo "$a"; return 0
            fi ;;
    esac
    a=$(cat "$STATE_ADDR" 2>/dev/null)
    case "$a" in
        [0-9]*.[0-9]*.[0-9]*.[0-9]*)
            addr_taken_by_other "$a" "$ifc" || { echo "$a"; return 0; } ;;
    esac
    n=1
    while [ "$n" -lt 250 ]; do
        a="$ADDR_NET.$n"
        if ! addr_taken_by_other "$a" "$ifc"; then
            echo "$a" > "$STATE_ADDR" 2>/dev/null
            echo "$a"; return 0
        fi
        n=$((n + 1))
    done
    return 1
}

# ---- enrollment --------------------------------------------------------------
ensure_session() {
    [ -s "$SESSION" ] && return 0
    # State written by the first version of this wrapper lived inside the z2k tree and is
    # destroyed by a reinstall. Adopt it before deciding to register a brand-new device.
    for f in session.conf iface addr; do
        [ -s "$WARP_DIR_LEGACY/$f" ] && [ ! -s "$WARP_DIR/$f" ] && cp -f "$WARP_DIR_LEGACY/$f" "$WARP_DIR/$f" 2>/dev/null
    done
    [ -s "$SESSION" ] && { chmod 600 "$SESSION" 2>/dev/null; log "adopted warp state from the pre-migration location"; return 0; }
    # Adopt the package's device key instead of enrolling again: re-registering burns a new
    # WARP device for no reason and can fail where the existing one already works.
    if [ -s "$PKG_SESSION" ]; then
        cp -f "$PKG_SESSION" "$SESSION" 2>/dev/null && { log "adopted existing device key from the usque package"; return 0; }
    fi
    log "no device key — registering with Cloudflare"
    "$BIN" register --accept-tos --config "$SESSION" >> "$LOG" 2>&1
    [ -s "$SESSION" ]
}

# ---- NDM interface -----------------------------------------------------------
# Called ONLY after the tun netdev exists. That ordering is the whole point: the package
# configured NDM first and raced its own daemon, which is why first-enable needed a reboot.
setup_ndm_iface() {
    local ifc="$1" addr="$2" nd
    nd=$(ndm_name "$ifc")
    ndm "interface $nd"
    ndm "interface $nd description z2k-warp"
    ndm "interface $nd ip global auto"
    ndm "interface $nd ip tcp adjust-mss pmtu"
    ndm "interface $nd ip address $addr 255.255.255.255"
    ndm "interface $nd ip mtu $MTU"
    ndm "interface $nd up"
    # NDM sometimes leaves the link administratively down; a down link routes nothing.
    ip link show "$ifc" 2>/dev/null | grep -qw UP || ip link set "$ifc" up 2>/dev/null

    # VERIFY. Every ndm call above is `ndmc ... >/dev/null 2>&1`, so a refusal is
    # invisible: this function used to report success unconditionally, and the caller
    # runs it from a background subshell that discards the status anyway. Field case
    # (r-66): .ndm-saved present, link UP, and NO IPv4 on the interface at all — the
    # function had "worked" and lied, so the tunnel was up and carried nothing while
    # every log line looked healthy.
    # Match with `case`, not sed: `\b` is unsupported in BusyBox and BSD sed (it matched
    # nothing, so the first version of this check declared a correctly-applied address
    # missing), and the dots in an address are regex wildcards. A glob on the captured
    # line needs no escaping and no external tool.
    _addr_present() {
        local have
        have=" $(ip -o addr show "$1" 2>/dev/null | tr '\n' ' ') "
        case "$have" in
            *" inet $2/"*|*" inet $2 "*) return 0 ;;
        esac
        return 1
    }
    local w=0
    while [ "$w" -lt 10 ] && ! _addr_present "$ifc" "$addr"; do
        w=$((w + 1)); sleep 1
    done
    local ndm_took=1
    if ! _addr_present "$ifc" "$addr"; then
        # NDM refused or ignored it. Reporting and waiting is useless — the tunnel cannot
        # carry a single packet without an address, waiting has never made NDM change its
        # mind, and the field reports show it retrying to no effect until the budget runs
        # out ("на opkgtun0 нет IPv4-адреса" on every attempt).
        #
        # usque runs with --no-iproute2 precisely because SOMETHING ELSE has to configure
        # the device. NDM is the nice version of that — it also persists the config and
        # clamps MSS. When it will not, iproute2 still will: verified on a live router that
        # `ip addr add <addr>/32 dev opkgtunN` is accepted on the very device NDM manages.
        ndm_took=0
        log "NDM did not apply $addr to $nd — setting it directly. Have: [$(ip -o addr show "$ifc" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | tr '\n' ' ')]"
        ip addr add "$addr/32" dev "$ifc" 2>/dev/null
        ip link show "$ifc" 2>/dev/null | grep -qw UP || ip link set "$ifc" up 2>/dev/null
        w=0
        while [ "$w" -lt 5 ] && ! _addr_present "$ifc" "$addr"; do
            w=$((w + 1)); sleep 1
        done
    fi
    if ! _addr_present "$ifc" "$addr"; then
        log "could not put $addr on $ifc at all — NDM refused and iproute2 failed too; tunnel will carry nothing. Have: [$(ip -o addr show "$ifc" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | tr '\n' ' ')]"
        return 1
    fi
    [ "$ndm_took" = 0 ] && log "$addr is on $ifc via iproute2 (NDM does not hold it, so it will not survive a reboot — selfheal re-applies)"

    # `system configuration save` writes FLASH. It must never sit on the respawn path: a
    # degraded tunnel respawns for hours and would grind the router's flash down. Save once,
    # when the interface object is actually new, and never again.
    #
    # Deliberately AFTER the verification: creating the marker on a failed apply meant the
    # next start skipped the save entirely, so a router that failed once could never
    # persist a correct config afterwards.
    # Only when NDM actually holds the config. Saving after an iproute2 fallback would
    # write flash to persist a configuration NDM does not have, and worse, set the marker
    # so no later start ever tries to save the real thing once NDM starts cooperating.
    if [ "$ndm_took" = 1 ] && [ ! -f "$WARP_DIR/.ndm-saved" ]; then
        ndm "system configuration save"
        touch "$WARP_DIR/.ndm-saved" 2>/dev/null
    fi
    return 0
}

release_ndm_iface() {
    local ifc nd
    ifc=$(cat "$STATE_IFACE" 2>/dev/null) || return 0
    [ -n "$ifc" ] || return 0
    nd=$(ndm_name "$ifc")
    ndm "interface $nd down"
}

# NDM interface name -> netdev name (OpkgTun1 -> opkgtun1), the inverse of ndm_name.
dev_name() { echo "$1" | sed 's/^Opkg/opkg/; s/Tun/tun/'; }

# Is an NDM interface object registered? ndmc EXITS 0 EVEN WHEN IT REFUSES a command
# (verified on the box: `no interface OpkgTun9` for a nonexistent object prints
# "Command::Base error[7405602]: argument parse error." and still returns 0), so a
# status check cannot tell success from failure and the state has to be re-read. A
# registered interface answers with its own `id:`; a missing one answers with that
# error and no id line.
ndm_iface_exists() {
    LD_LIBRARY_PATH= ndmc -c "show interface $1" 2>/dev/null \
        | grep -qE "^[[:space:]]*id:[[:space:]]*$1[[:space:]]*$"
}

# ---- stale package interfaces ------------------------------------------------
# The usque-keenetic package used to own the tunnel and registered its OWN NDM object,
# named after "first free opkgtunN". Once z2k occupied opkgtun0 the package's next start
# picked opkgtun1 and created OpkgTun1 - with the address p-64.1 had written into the
# package's config. Handing the tunnel to us left that object behind in startup-config
# for good: NDM restores it on every boot, so it survives even though the package
# service is disabled. Observed on the owner's router: OpkgTun1, description "usque",
# no netdev, state error, holding 172.16.240.2.
#
# It is not merely untidy. It still HOLDS an address out of our own fallback range, and
# NDM refuses to raise an interface onto a network another interface already owns - the
# failure mode documented at addr_taken_by_other(). The comment p-64.1 left in that
# router's package config ("was 172.16.240.1, taken by another interface") is that
# collision having already happened once.
#
# Reap it, but only when all three hold - an OpkgTun object can equally belong to a
# tunnel the user runs themselves (sing-box, xray, AmneziaWG), and deleting one of those
# would tear down a stranger's interface and save that into startup-config:
#   * it is NOT the interface we chose;
#   * its description is exactly "usque" - the package's signature, never ours (we write
#     "z2k-warp"), and never a user-typed description, which NDM stores quoted;
#   * no kernel netdev of that name exists, so nothing is running on it.
reap_pkg_ifaces() {
    local ours nd dev desc reaped=0
    ours=$(ndm_name "$1")
    # One `show running-config` for the whole list, not 16 probes: this sits on the
    # start path and every ndmc call is a round trip.
    for nd in $(LD_LIBRARY_PATH= ndmc -c "show running-config" 2>/dev/null \
                | sed -n 's/^interface \(OpkgTun[0-9]*\)[[:space:]]*$/\1/p'); do
        [ "$nd" = "$ours" ] && continue
        dev=$(dev_name "$nd")
        ip link show "$dev" >/dev/null 2>&1 && continue
        desc=$(LD_LIBRARY_PATH= ndmc -c "show interface $nd" 2>/dev/null \
               | sed -n 's/^[[:space:]]*description:[[:space:]]*\(.*\)$/\1/p' | head -1)
        [ "$desc" = usque ] || continue
        ndm "no interface $nd"
        # VERIFY, for the same reason setup_ndm_iface does: ndmc reports success it did
        # not achieve. Claiming a removal that did not happen would also spend a flash
        # write on nothing.
        if ndm_iface_exists "$nd"; then
            log "could NOT remove stale NDM interface $nd — still registered"
            continue
        fi
        log "removed stale NDM interface $nd (usque-package leftover: no netdev, description usque)"
        reaped=1
    done
    # Persist ONLY when something was actually removed - otherwise NDM restores the
    # object on the next boot and the reap is pointless. Guarded because
    # `system configuration save` writes flash and this runs on every start.
    [ "$reaped" = 1 ] && ndm "system configuration save"
    return 0
}

# ---- supervisor --------------------------------------------------------------
is_running() {
    [ -f "$PIDFILE" ] || return 1
    kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

start() {
    [ -x "$BIN" ] || { log "engine missing: $BIN"; exit 0; }
    # MUTUAL EXCLUSION around the whole check-and-spawn. ensure_session below can block for
    # tens of seconds on a DPI-blocked registration endpoint, and self-heal fires every 25s —
    # without this, a second supervisor spawns, only one pid lands in the pidfile, and the
    # orphan is unreachable by stop() and by uninstall: it resurrects the engine after every
    # stop and keeps running a deleted binary. mkdir is the atomic primitive available here.
    LOCKDIR="${LOCKDIR:-/var/run/z2k-warp.lock}"
    if ! mkdir "$LOCKDIR" 2>/dev/null; then
        # Stale lock from a killed start: adopt it only when its owner is gone.
        _owner=$(cat "$LOCKDIR/pid" 2>/dev/null)
        if [ -n "$_owner" ] && kill -0 "$_owner" 2>/dev/null; then
            echo "$NAME: start already in progress (pid $_owner)"
            return 0
        fi
        rm -rf "$LOCKDIR" 2>/dev/null
        mkdir "$LOCKDIR" 2>/dev/null || { echo "$NAME: cannot take the start lock"; return 1; }
    fi
    echo $$ > "$LOCKDIR/pid" 2>/dev/null
    trap 'rm -rf "$LOCKDIR" 2>/dev/null' EXIT INT TERM
    if is_running; then
        echo "$NAME already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    # The package's own service must not fight us over the same device key and interface.
    # Stopping it is not enough: Entware runs every executable /opt/etc/init.d/S* at boot,
    # and "S51usque" sorts BEFORE "S51z2k-warp", so on every reboot it would start first,
    # grab the interface and the key, and we would then have to tear it back down. Take its
    # executable bit instead — the standard Entware way to disable a service, reversible with
    # a chmod, and it leaves the package itself installed and untouched.
    if [ -x "$PKG_INIT" ]; then
        "$PKG_INIT" stop >/dev/null 2>&1
        chmod -x "$PKG_INIT" 2>/dev/null && log "disabled the usque-keenetic service (z2k owns the tunnel now)"
    fi
    ensure_session || { log "registration failed — cannot start"; echo "$NAME: registration failed"; return 1; }

    local ifc addr
    ifc=$(iface_name)
    # Before choosing an address: a leftover object can be holding the very address we
    # are about to ask for, and NDM would then refuse to raise our interface.
    reap_pkg_ifaces "$ifc"
    addr=$(iface_addr "$ifc") || { log "no free address in $ADDR_NET.0/24"; return 1; }
    log "starting on $ifc ($addr)"
    echo "Starting $NAME on $ifc ($addr)..."

    # SUPERVISOR (s6/runit pattern in shell — Entware has no systemd/procd). The pidfile
    # holds the supervisor, parent of the daemon, respawning it with capped backoff.
    # `trap '' HUP` keeps the MIPS busybox SIGHUP fix; no `nohup` — busybox does not ship it.
    (
        trap '' HUP
        trap 'kill "$child" 2>/dev/null; exit 0' TERM INT
        backoff=1
        while :; do
            t0=$(date +%s 2>/dev/null || echo 0)
            # ENDPOINT VARIANT, if one was chosen. Both files are ABSENT by default, so a
            # router whose tunnel works never takes this path and its behaviour is byte for
            # byte what it was.
            #
            # usque has no flag for the endpoint IP — only -P for the port — and the IP
            # comes from the config file. We therefore never touch $SESSION, which holds
            # the device key and whose corruption would cost the registration: the variant
            # is a COPY, selected with -c. Verified on a live router that both a different
            # endpoint (188.114.98.1) and a different port (8443) reach
            # "Tunnel established".
            _cfg="$SESSION"
            [ -s "$WARP_DIR/session.alt.conf" ] && _cfg="$WARP_DIR/session.alt.conf"
            _pflag=""
            _p=$(cat "$WARP_DIR/port" 2>/dev/null)
            case "$_p" in
                ''|*[!0-9]*) ;;
                *) _pflag="-P $_p" ;;
            esac
            [ "$_cfg" = "$SESSION" ] || log "using endpoint variant config $(basename "$_cfg")${_pflag:+ $_pflag}"
            # shellcheck disable=SC2086  # _pflag is deliberately word-split: empty = no flag
            GODEBUG=asyncpreemptoff=1 "$BIN" nativetun \
                --config "$_cfg" --interface-name "$ifc" --no-iproute2 \
                -s "$SNI" --http2 -k "$KEEPALIVE" $_pflag </dev/null >> "$LOG" 2>&1 &
            child=$!
            # Configure NDM once the tun netdev actually exists — never before.
            (
                w=0
                while [ "$w" -lt 30 ] && ! ip link show "$ifc" >/dev/null 2>&1; do
                    w=$((w + 1)); sleep 1
                done
                if ip link show "$ifc" >/dev/null 2>&1; then
                    setup_ndm_iface "$ifc" "$addr" \
                        || log "interface setup FAILED for $ifc ($addr) — selfheal will retry"
                else
                    log "$ifc never appeared within 30s — usque did not create the tun"
                fi
            ) &
            wait "$child"
            t1=$(date +%s 2>/dev/null || echo 0)
            if [ $((t1 - t0)) -ge 60 ]; then backoff=1; else
                backoff=$((backoff * 2)); [ "$backoff" -gt 30 ] && backoff=30
            fi
            echo "$(date 2>/dev/null) [$NAME] engine exited, respawn in ${backoff}s" >> "$LOG"
            sleep "$backoff"
        done
    ) &
    echo $! > "$PIDFILE"
    rm -rf "$LOCKDIR" 2>/dev/null
    return 0
}

stop() {
    echo "Stopping $NAME..."
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    # The supervisor kills its child on TERM, but a stray engine from an earlier run (or a
    # supervisor that died without cleaning up) must not survive and hold the tun device.
    killall z2k-usque 2>/dev/null
    release_ndm_iface
    log "stopped"
}

status() {
    local ifc
    ifc=$(cat "$STATE_IFACE" 2>/dev/null)
    if is_running; then
        echo "$NAME is running (supervisor $(cat "$PIDFILE"), iface ${ifc:-?})"
    else
        echo "$NAME is stopped"
        return 1
    fi
}

# Sourced by tests/test_warp_init.sh to exercise the decision functions (interface identity,
# address selection) without spawning anything — mirrors z2k-warp.sh's guard. 241 lines of
# tunnel lifecycle shipped with zero coverage until this existed.
[ -n "$Z2K_WARP_INIT_SOURCE_ONLY" ] && return 0

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *)       echo "Usage: $0 {start|stop|restart|status}" ;;
esac
