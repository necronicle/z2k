#!/bin/sh
# /opt/etc/init.d/S51z2k-warp — запуск/остановка движка z2k-warpd.
#
# Движок сам себе супервизор (реконнект, лестница транспортов, liveness —
# внутри); здесь только pidfile и окружение. Бинаря нет — значит WARP не
# установлен, и это штатно: ничего не делаем и выходим 0, чтобы Entware не
# считал сервис сломанным. Бинарь появляется по кнопке «Установить»
# (z2k-warp.sh install) и исчезает по «Удалить».
# Z2K_STUB_PATH — только для тестов: каталог со стабами iptables/ipset/uname
# встаёт перед системным PATH. В проде переменной нет.
export PATH="${Z2K_STUB_PATH:+$Z2K_STUB_PATH:}/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/sbin:/usr/sbin:/bin:/usr/bin"

BIN="${BIN:-/opt/sbin/z2k-warpd}"
PIDFILE="${PIDFILE:-/var/run/z2k-warpd.pid}"

[ -x "$BIN" ] || exit 0

# Go async-preempt роняет процесс на MIPS (известный краш) — выключаем.
case "$(uname -m)" in mips*) export GODEBUG=asyncpreemptoff=1 ;; esac

# Z2K_WARP_FORCE — закрепить ОДИН шаг лестницы на время подбора плеча десинка
# (z2k-warp.sh warp_masque_tune). Живёт только в этом процессе: обычный start
# без переменной поднимает движок с полной лестницей, поэтому подбор не может
# оставить роутер запертым на h2 навсегда.
#
# Значение проверяем, а не подставляем как есть: оно уезжает в командную
# строку демона.
FORCE_ARG=""
case "$Z2K_WARP_FORCE" in
    "")   : ;;
    h2)   FORCE_ARG="-force-transport h2" ;;
    wg:[0-9]*|wg:[0-9]*.[0-9]*.[0-9]*.[0-9]*:[0-9]*) FORCE_ARG="-force-transport $Z2K_WARP_FORCE" ;;
    *)    echo "z2k-warpd: Z2K_WARP_FORCE=$Z2K_WARP_FORCE не распознан — игнорирую" >&2 ;;
esac

# VPS-релей для API Cloudflare, если напрямую заблокирован: тот же, что у
# регистрации в z2k-warp.sh (переопределяется Z2K_WARP_VPS_PROXY в конфиге).
_cfg="${ZAPRET2_DIR:-/opt/zapret2}/config"
_proxy=$(grep -m1 '^Z2K_WARP_VPS_PROXY=' "$_cfg" 2>/dev/null | cut -d= -f2- | tr -d '"')
export Z2K_WARP_VPS_PROXY="${_proxy:-http://z2kwarp:z2kW4rpR3g2026@213.176.74.63:8119}"

# ЗАПУСКАТЬ ИЛИ НЕТ, РЕШАЕТ ФЛАГ, А НЕ НАЛИЧИЕ БИНАРНИКА.
#
# Бинарник остаётся на диске и после «Выключить WARP» — чтобы повторное
# включение не качало семь мегабайт заново. Без этой проверки первый же ребут
# поднимал движок тому, кто WARP выключил: Entware при загрузке дёргает все
# S*-скрипты подряд, туннель вставал, NAT и MASQUERADE появлялись, и роутер
# ходил к Cloudflare круглосуточно при GAME_WARP_ENABLED=0.
#
# Нет конфига — не запускаем: включённость подтверждается, а не предполагается.
warp_enabled() {
    [ "$(grep -m1 '^GAME_WARP_ENABLED=' "$_cfg" 2>/dev/null | cut -d= -f2 | tr -d '" ')" = "1" ]
}

# Два источника правды, и это не перестраховка. Неудачный старт (замок занят,
# TUN занят) писал в pidfile мёртвый pid — и selfheal каждые 25 с поднимал
# новый обречённый процесс при ЖИВОМ демоне, снося ему status.json. Поле
# r-79.4, три диагностики.
running() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
        return 0
    fi
    pgrep -f "$BIN run" >/dev/null 2>&1
}

case "$1" in
    start)
        if ! warp_enabled; then
            echo "z2k-warpd: WARP выключен (GAME_WARP_ENABLED=1 включает) — не запускаю"
            exit 0
        fi
        if running; then
            echo "z2k-warpd already running (pid $(cat "$PIDFILE"))"
            exit 0
        fi
        mkdir -p /tmp/z2k-warp "$(dirname "$PIDFILE")" 2>/dev/null
        # Отвязка от потоков обязательна: NDM читает вывод init-скрипта до
        # конца потока, а демон унаследовал бы его и держал открытым.
        # shellcheck disable=SC2086  # FORCE_ARG — либо пусто, либо два слова
        "$BIN" run $FORCE_ARG >/dev/null 2>&1 </dev/null &
        _pid=$!
        # Даём процессу секунду умереть: мёртвый pid в pidfile — это вечная
        # карусель перезапусков (см. running выше).
        sleep 1
        if kill -0 "$_pid" 2>/dev/null; then
            echo "$_pid" > "$PIDFILE"
            echo "z2k-warpd started (pid $_pid)"
        else
            rm -f "$PIDFILE"
            echo "z2k-warpd не поднялся — см. /tmp/z2k-warp/warpd.log"
        fi
        ;;
    stop)
        if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
            rm -f "$PIDFILE"
        fi
        # Пидфайл мог разойтись с реальностью — добиваем по имени.
        # pkill НА РОУТЕРЕ НЕТ: Entware собирает busybox без этого апплета, и вызов под
        # `2>/dev/null` не падал — он просто НИКОГДА НЕ СРАБАТЫВАЛ (тот же класс, что
        # od -A в issue #43). killall бьёт по имени и снёс бы чужие процессы; pgrep -f
        # есть. $$ пропускаем: busybox pgrep вызывающую оболочку не исключает.
        for _p in $(pgrep -f "$BIN run" 2>/dev/null); do
            [ "$_p" = "$$" ] && continue
            kill "$_p" 2>/dev/null
        done
        echo "z2k-warpd stopped"
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        if running; then
            echo "z2k-warpd running (pid $(cat "$PIDFILE"))"
        else
            echo "z2k-warpd stopped"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
