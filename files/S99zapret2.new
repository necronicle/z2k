#!/bin/sh
# /opt/etc/init.d/S99zapret2
# ��������� ������������ init.d/openwrt/zapret2 ��� Keenetic
# ���������� ������ common/ � config ���� ������ hardcoded ��������

# ==============================================================================
# ���� � ����������
# ==============================================================================

ZAPRET_BASE=/opt/zapret2
ZAPRET_RW=${ZAPRET_RW:-"$ZAPRET_BASE"}
ZAPRET_CONFIG=${ZAPRET_CONFIG:-"$ZAPRET_RW/config"}

# �������� ��� zapret2 ����������
[ -d "$ZAPRET_BASE" ] || {
    echo "ERROR: zapret2 not installed in $ZAPRET_BASE"
    exit 1
}

# ==============================================================================
# SOURCE ����������� ������� (��� � init.d/openwrt/functions)
# ==============================================================================

# ������� �������
. "$ZAPRET_BASE/common/base.sh"

# ------------------------------------------------------------------------------
# Z2K: fast substring test + bounded condition waits
# ------------------------------------------------------------------------------
# Shadow of common/base.sh's contains(). THIS is what delivers the restart win:
# the engine's own copy is still the quadratic `${1#*$2}` form on every router in
# the field (verified 2026-07-26 on the owner's box), because the engine arrives as
# a GitHub release tarball of the fork, on its own schedule, and the fix there is
# not released yet. Sourced right after base.sh, so it overrides the slow version
# for this whole process no matter which engine build is installed.
# Drop this shadow only once the fixed engine is the FLOOR version, not merely
# released. Rationale and measurements in the fork's common/base.sh.
contains()
{
	# Empty-needle guard mirrors the old form exactly; see common/base.sh.
	[ -n "$2" ] || return 1
	case "$1" in *"$2"*) return 0 ;; esac
	return 1
}

# Sub-second sleep, probed once. BusyBox `sleep` here is built without fractional
# support ("sleep: invalid number '0.1'") and `read -t` rejects fractions, so
# usleep (a BusyBox applet on Entware) is the portable path. Where it is absent
# callers MUST fall back to whole seconds and shrink their poll count to match -
# never keep the poll count and let the deadline stretch.
Z2K_FRACSLEEP=
z2k_fracsleep_avail()
{
    # Probe by EXECUTING, not by `command -v`. A PATH entry proves a file
    # exists, not that it runs: a BusyBox build without the usleep applet still
    # answers `command -v usleep` through the multi-call symlink and then fails
    # at every call. That combination is exactly the deadline-stretch this
    # design exists to prevent - the frac branch would be selected (n = max*20)
    # while each usleep fell through to a whole second, turning a 3 s SIGKILL
    # deadline into 60 s and stalling every restart behind a wedged daemon.
    [ -n "$Z2K_FRACSLEEP" ] || {
        if usleep 1 >/dev/null 2>&1; then Z2K_FRACSLEEP=1; else Z2K_FRACSLEEP=0; fi
    }
    [ "$Z2K_FRACSLEEP" = 1 ]
}

# Is pid $1 a RUNNING process — not merely a pid that kill -0 accepts?
#
# kill -0 succeeds for a ZOMBIE, so "the daemon is alive" was really "the daemon
# has not been reaped yet". The old flat `sleep 1` hid that: a foreground external
# command gave the shell time to reap the corpse, so the following kill -0 saw
# ESRCH. Any replacement that polls faster than the reap inherits a false
# "started" — stale pidfile, lying `status`, and a broken option string that looks
# fine. Reading the state field out of /proc removes the timing dependency
# entirely: a zombie is 'Z' no matter how fast we look.
#
# /proc/<pid>/stat field 3 is the state. The comm field (2) can contain spaces and
# parentheses, so parse after the LAST ')'.
z2k_pid_running()
{
    kill -0 "$1" 2>/dev/null || return 1
    [ -r "/proc/$1/stat" ] || return 0   # no procfs: fall back to kill -0
    local st
    st=$(awk '{ n=match($0, /\)[^)]*$/); if (n) print substr($0, n+2, 1) }' "/proc/$1/stat" 2>/dev/null)
    case "$st" in
        Z|X|x) return 1 ;;               # zombie / dead
    esac
    return 0
}

# Wait for pid $1 to exit, at most $2 whole seconds. The ceiling is in TIME, not
# in iterations: without fractional sleep a 3 s deadline must stay 3 s, not
# become 3 s x N polls - a wedged daemon (OOM, MIPS async-preempt) would
# otherwise stall every restart and self-heal. Returns 0 once it is gone.
z2k_wait_gone()
{
    local pid="$1" max="${2:-3}" i=0 n
    if z2k_fracsleep_avail; then
        n=$(( max * 20 ))
        while [ "$i" -lt "$n" ]; do
            kill -0 "$pid" 2>/dev/null || return 0
            # Deliberately NO `|| sleep 1` here. z2k_fracsleep_avail already
            # proved usleep runs; a failure now is anomalous, and falling back
            # to a whole second would multiply the remaining 60 polls into a
            # 60 s deadline - the precise bug the probe above guards. Spinning
            # out the remaining iterations instead exits EARLY, which is bounded
            # and safe; the caller re-checks liveness either way.
            usleep 50000 2>/dev/null
            i=$((i+1))
        done
    else
        while [ "$i" -lt "$max" ]; do
            z2k_pid_running "$pid" || return 0
            sleep 1
            i=$((i+1))
        done
    fi
    kill -0 "$pid" 2>/dev/null || return 0
    return 1
}

# Positive readiness for nfqws2: its NFQUEUE is bound. One line per bound queue
# in /proc/net/netfilter/nfnetlink_queue, first field = queue number. Replaces a
# flat `sleep 1` that verified nothing and outlasted the daemon's entire init
# (measured 0.27 s). A timeout is deliberately NOT an error - on a cold USB the
# daemon may still be loading 80k hostlines; the caller re-checks liveness.
z2k_wait_queue_bound()
{
    local pid="$1" qnum="$2" max="${3:-3}" i=0 n q owner rest
    if z2k_fracsleep_avail; then n=$(( max * 20 )); else n="$max"; fi
    while [ "$i" -lt "$n" ]; do
        z2k_pid_running "$pid" || return 1
        while read -r q owner rest; do
            # Match the queue number AND its owner. Column 2 is the netlink peer
            # portid = the binding process's pid (verified on the box: pidfile
            # 384 <-> portid 384; nfqws2 is never started with --daemon here, so
            # $! is the real daemon). Matching qnum alone returns instantly off a
            # queue ANOTHER instance already owns - which both skips waiting for
            # THIS daemon and destroys the window in which an instantly-dying
            # daemon is reported as a failed start.
            [ "$q" = "$qnum" ] && [ "$owner" = "$pid" ] && return 0
        # 2>/dev/null MUST precede the input redirect. Redirections are applied
        # left to right, so `< file 2>/dev/null` still reports "can't open" on
        # the un-redirected fd 2 - verified on BusyBox ash 1.37.0, dash and bash.
        # Without nfnetlink_queue procfs (module not loaded, netns) that is 60
        # identical error lines per daemon start on the console/webpanel.
        done 2>/dev/null < /proc/net/netfilter/nfnetlink_queue
        # See z2k_wait_gone: no `|| sleep 1` on the frac path - it would turn
        # the remaining polls into whole seconds and stretch the deadline.
        if z2k_fracsleep_avail; then usleep 50000 2>/dev/null; else sleep 1; fi
        i=$((i+1))
    done
    return 0
}

# ����������� ���� firewall (iptables/nftables)
. "$ZAPRET_BASE/common/fwtype.sh"

# KEENETIC FIX: �������������� linux_ipt_avail ��� ������ ��� ip6tables
# �� Keenetic ����� ���� DISABLE_IPV6=1, �� iptables ��� ����� ��������
linux_ipt_avail()
{
	# ��� Keenetic ���������� ������ iptables (IPv4-only �����)
	[ -n "$Z2K_DEBUG" ] && echo "DEBUG: linux_ipt_avail() �������"
	exists iptables
	local result=$?
	[ -n "$Z2K_DEBUG" ] && echo "DEBUG: exists iptables = $result"
	return $result
}

# IP helper functions
. "$ZAPRET_BASE/common/linux_iphelper.sh"

# ������� ��� ������ � iptables
