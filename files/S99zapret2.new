[ -n "$Z2K_DEBUG" ] && echo "DEBUG: std_ports() ������� - NFQWS2_PORTS_TCP_IPT='$NFQWS2_PORTS_TCP_IPT'"

# ------------------------------------------------------------------------------
# �������� ������ ��� ORCHESTRATION (STRICT MANUAL MODE)
# ------------------------------------------------------------------------------
# ��� ���������� ������ ������������� (��������, circular) ��������� ������
# �������� RST/redirect � �.�. ������� �������� �������� ������� �� ���������.
[ -z "$NFQWS2_TCP_PKT_IN" ] && NFQWS2_TCP_PKT_IN="$NFQWS2_TCP_PKT_OUT"
[ -z "$NFQWS2_UDP_PKT_IN" ] && NFQWS2_UDP_PKT_IN="$NFQWS2_UDP_PKT_OUT"

# ------------------------------------------------------------------------------
# AUTOHOSTLIST: ensure required files exist to avoid nfqws2 start failures
# ------------------------------------------------------------------------------
ensure_autohostlist_files()
{
	[ "$MODE_FILTER" = "autohostlist" ] || return 0
	local base="${HOSTLIST_BASE:-$ZAPRET_BASE/ipset}"
	mkdir -p "$base" || return 1
	local auto="$base/zapret-hosts-auto.txt"
	local debuglog="$base/zapret-hosts-auto-debug.log"
	[ -f "$auto" ] || : > "$auto"
	[ "$AUTOHOSTLIST_DEBUGLOG" = "1" ] && [ -f "$debuglog" ] || : > "$debuglog"

	# Populate iptables exclude list from z2k whitelist so nfqueue never sees them
	local whitelist="${AUTOHOSTLIST_WHITELIST:-$ZAPRET_BASE/lists/whitelist.txt}"
	local exclude_txt="$base/zapret-hosts-exclude.txt"
	[ -f "$whitelist" ] && cp -f "$whitelist" "$exclude_txt" 2>/dev/null || : > "$exclude_txt"
}

normalize_autohost_domains()
{
	# Normalize possible host/domain forms to bare lowercase domain names.
	awk '
	{
		s=$0
		gsub(/\r/, "", s)
		sub(/#.*/, "", s)
		gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
		if (s == "") next

		s=tolower(s)
		sub(/^[a-z][a-z0-9+.-]*:\/\//, "", s)
		sub(/\/.*/, "", s)
		sub(/:[0-9]+$/, "", s)
		gsub(/^\*\./, "", s)
		sub(/\.$/, "", s)
		gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
		if (s == "") next

		if (s ~ /[^a-z0-9.-]/) next
		if (s ~ /\.\./) next
		if (index(s, ".") == 0) next

		n=split(s, a, ".")
		if (n < 2) next
		bad=0
		for (i=1; i<=n; i++) {
			if (a[i] == "") { bad=1; break }
			if (a[i] ~ /^-/ || a[i] ~ /-$/) { bad=1; break }
			if (a[i] !~ /^[a-z0-9-]+$/) { bad=1; break }
		}
		if (bad) next
		print s
	}
	'
}

sync_autohostlist_to_rkn()
{
	[ "${AUTOHOSTLIST_SYNC_TO_RKN:-1}" = "1" ] || return 0

	local base="${HOSTLIST_BASE:-$ZAPRET_BASE/ipset}"
	local auto="${AUTOHOSTLIST_FILE:-$base/zapret-hosts-auto.txt}"
	local rkn_list="${AUTOHOSTLIST_RKN_LIST:-$ZAPRET_BASE/extra_strats/TCP/RKN/List.txt}"
	local whitelist="${AUTOHOSTLIST_WHITELIST:-$ZAPRET_BASE/lists/whitelist.txt}"

	[ -s "$auto" ] || return 0
	mkdir -p "$(dirname "$rkn_list")" 2>/dev/null || true
	[ -f "$rkn_list" ] || : > "$rkn_list"

	local tmp_auto tmp_have tmp_add tmp_final
	tmp_auto="$(mktemp /tmp/z2k_ah_auto.XXXXXX 2>/dev/null || echo "/tmp/z2k_ah_auto.$$")"
	tmp_have="$(mktemp /tmp/z2k_ah_have.XXXXXX 2>/dev/null || echo "/tmp/z2k_ah_have.$$")"
	tmp_add="$(mktemp /tmp/z2k_ah_add.XXXXXX 2>/dev/null || echo "/tmp/z2k_ah_add.$$")"
	tmp_final="$(mktemp /tmp/z2k_ah_final.XXXXXX 2>/dev/null || echo "/tmp/z2k_ah_final.$$")"

	normalize_autohost_domains < "$auto" | sort -u > "$tmp_auto" 2>/dev/null || true
	[ -s "$tmp_auto" ] || {
		rm -f "$tmp_auto" "$tmp_have" "$tmp_add" "$tmp_final" 2>/dev/null || true
		return 0
	}

	{
		[ -f "$rkn_list" ] && cat "$rkn_list"
		[ -f "$whitelist" ] && cat "$whitelist"
	} | normalize_autohost_domains | sort -u > "$tmp_have" 2>/dev/null || true

	awk 'NR==FNR { seen[$0]=1; next } !($0 in seen) { print }' "$tmp_have" "$tmp_auto" > "$tmp_add"
	local added
	added=$(awk 'END { print NR+0 }' "$tmp_add")

	if [ "$added" -gt 0 ]; then
		cat "$tmp_add" >> "$rkn_list"
		sort -u "$rkn_list" > "$tmp_final" 2>/dev/null && mv "$tmp_final" "$rkn_list"
		echo "autohostlist sync: added $added domains to $rkn_list"
		# Clear the auto list to prevent infinite growth and redundant reparsing
		: > "$auto"
	fi

	rm -f "$tmp_auto" "$tmp_have" "$tmp_add" "$tmp_final" 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# AUTOCIRCULAR: ensure writable cache files for runtime user (WS_USER / nobody)
# ------------------------------------------------------------------------------
ensure_autocircular_files()
{
	local base="${EXTRA_STRATS_DIR:-$ZAPRET_BASE/extra_strats}/cache/autocircular"
	mkdir -p "$base" || return 1
	chmod 755 "$base" 2>/dev/null || true
	chown nobody "$base" 2>/dev/null || true
	rm -f "$base/state.tsv.lock" \
	      "$base/state.tsv.tmp" \
	      "$base/telemetry.tsv.lock" \
	      "$base/telemetry.tsv.tmp" 2>/dev/null || true

	[ -f "$base/state.tsv" ] || : > "$base/state.tsv"
	chmod 644 "$base/state.tsv" 2>/dev/null || true
	chown nobody "$base/state.tsv" 2>/dev/null || true

	[ -f "$base/telemetry.tsv" ] || : > "$base/telemetry.tsv"
	chmod 644 "$base/telemetry.tsv" 2>/dev/null || true
	chown nobody "$base/telemetry.tsv" 2>/dev/null || true

	[ -f "$base/debug.log" ] || : > "$base/debug.log"
	chmod 644 "$base/debug.log" 2>/dev/null || true
	chown nobody "$base/debug.log" 2>/dev/null || true

	# Optional debug toggle file; keep if present and readable.
	[ -f "$base/debug.flag" ] && chmod 644 "$base/debug.flag" 2>/dev/null || true
	[ -f "$base/debug.flag" ] && chown nobody "$base/debug.flag" 2>/dev/null || true
}

repair_autocircular_files_after_daemon_start()
{
	# nfqws2 can touch autocircular files very early during boot/restart.
	# Re-apply ownership after daemon spawn so runtime keeps using primary cache.
	ensure_autocircular_files
	# The t+1s re-apply stays (it covers nfqws2 touching these files just after
	# exec/lua init - commit 49991d0 guards both sides of that race), but it no
	# longer blocks the restart: it only re-applies ownership, and nothing
	# downstream in start() reads these files.
	( sleep 1; ensure_autocircular_files ) >/dev/null 2>&1 &
}

# ------------------------------------------------------------------------------
# TRAFFIC DEBUG: capture "real traffic" (tcpdump pcap) and "traffic in zapret" (nfqws2 --debug log)
# ------------------------------------------------------------------------------
Z2K_TRAFFIC_DEBUG=0
Z2K_TRAFFIC_DEBUG_BASE=""
Z2K_TRAFFIC_DEBUG_PIDFILE=""

ensure_traffic_debug_files()
{
	local base="${EXTRA_STRATS_DIR:-$ZAPRET_BASE/extra_strats}/cache/traffic"
	mkdir -p "$base" || return 1
	chmod 755 "$base" 2>/dev/null || true
	chown nobody "$base" 2>/dev/null || true

	[ -f "$base/nfqws2.debug.log" ] || : > "$base/nfqws2.debug.log"
	chmod 644 "$base/nfqws2.debug.log" 2>/dev/null || true
	chown nobody "$base/nfqws2.debug.log" 2>/dev/null || true

	[ -f "$base/tcpdump.err.log" ] || : > "$base/tcpdump.err.log"
	chmod 644 "$base/tcpdump.err.log" 2>/dev/null || true
	chown nobody "$base/tcpdump.err.log" 2>/dev/null || true

	# Optional toggle file; keep if present and readable.
	[ -f "$base/debug.flag" ] && chmod 644 "$base/debug.flag" 2>/dev/null || true
	[ -f "$base/debug.flag" ] && chown nobody "$base/debug.flag" 2>/dev/null || true
}

traffic_debug_prepare()
{
	local base="${EXTRA_STRATS_DIR:-$ZAPRET_BASE/extra_strats}/cache/traffic"
	Z2K_TRAFFIC_DEBUG_BASE="$base"
	Z2K_TRAFFIC_DEBUG_PIDFILE="$base/tcpdump.pid"

	if [ -f "$base/debug.flag" ]; then
		Z2K_TRAFFIC_DEBUG=1
	else
		Z2K_TRAFFIC_DEBUG=0
	fi
}

traffic_debug_enable_nfqws2_log()
{
	[ "$Z2K_TRAFFIC_DEBUG" = "1" ] || return 0

	# Avoid duplicating the option if start() is called twice in one script run.
	case " $NFQWS2_OPT_BASE " in
		*" --debug="*)
			return 0
			;;
	esac

	NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --debug=@$Z2K_TRAFFIC_DEBUG_BASE/nfqws2.debug.log"
}

traffic_debug_build_tcpdump_filter()
{
	local tok list item
	local tcp_ports=""
	local udp_ports=""
	local tcp_expr=""
	local udp_expr=""
	local filter=""

	# Collect all TCP/UDP filter ports from every NFQWS2 profile (--new separated).
	for tok in $NFQWS2_OPT; do
		case "$tok" in
			--filter-tcp=*)
				list="${tok#--filter-tcp=}"
				for item in $(echo "$list" | tr ',' ' '); do
					case "$item" in
						''|*[!0-9-]*)
							continue
							;;
					esac
					case " $tcp_ports " in
						*" $item "*) ;;
						*) tcp_ports="$tcp_ports $item" ;;
					esac
				done
				;;
			--filter-udp=*)
				list="${tok#--filter-udp=}"
				for item in $(echo "$list" | tr ',' ' '); do
					case "$item" in
						''|*[!0-9-]*)
							continue
							;;
					esac
					case " $udp_ports " in
						*" $item "*) ;;
						*) udp_ports="$udp_ports $item" ;;
					esac
				done
				;;
		esac
	done

	for item in $tcp_ports; do
		case "$item" in
			*-*)
				local first="${item%-*}"
				local last="${item#*-}"
				case "$first$last" in
					''|*[!0-9]*)
						continue
						;;
				esac
				[ -n "$tcp_expr" ] && tcp_expr="$tcp_expr or "
				tcp_expr="${tcp_expr}portrange $first-$last"
				;;
			*)
				[ -n "$tcp_expr" ] && tcp_expr="$tcp_expr or "
				tcp_expr="${tcp_expr}port $item"
				;;
		esac
	done

	for item in $udp_ports; do
		case "$item" in
			*-*)
				local first="${item%-*}"
				local last="${item#*-}"
				case "$first$last" in
					''|*[!0-9]*)
						continue
						;;
				esac
				[ -n "$udp_expr" ] && udp_expr="$udp_expr or "
				udp_expr="${udp_expr}portrange $first-$last"
				;;
			*)
				[ -n "$udp_expr" ] && udp_expr="$udp_expr or "
				udp_expr="${udp_expr}port $item"
				;;
		esac
	done

	[ -n "$tcp_expr" ] && filter="(tcp and ($tcp_expr))"
	if [ -n "$udp_expr" ]; then
		[ -n "$filter" ] && filter="$filter or "
		filter="${filter}(udp and ($udp_expr))"
	fi

	if [ -z "$filter" ]; then
		filter='(tcp and (port 80 or port 443 or port 2053 or port 2083 or port 2087 or port 2096 or port 8443)) or (udp and port 443)'
	fi

	echo "$filter"
}

traffic_debug_tcpdump_start()
{
	[ "$Z2K_TRAFFIC_DEBUG" = "1" ] || return 0

	exists tcpdump || {
		echo "WARN: traffic debug enabled, but tcpdump not found; skipping pcap capture"
		return 0
	}

	# Stop previous tcpdump if pidfile exists (stale or running).
	traffic_debug_tcpdump_stop

	local pcap="$Z2K_TRAFFIC_DEBUG_BASE/traffic.pcap"
	local err="$Z2K_TRAFFIC_DEBUG_BASE/tcpdump.err.log"
	local filter
	filter="$(traffic_debug_build_tcpdump_filter)"

	# Rotate by size to avoid filling storage: 10 files x 5MB = ~50MB max.
	# NOTE: if tcpdump doesn't support -C/-W, it will fail; see tcpdump.err.log.
	tcpdump -i any -nn -s 0 -U -w "$pcap" -C 5 -W 10 "$filter" >/dev/null 2>>"$err" &
	local pid=$!
	echo "$pid" > "$Z2K_TRAFFIC_DEBUG_PIDFILE"
	chmod 644 "$Z2K_TRAFFIC_DEBUG_PIDFILE" 2>/dev/null || true
	echo "traffic debug: tcpdump filter: $filter"
	echo "traffic debug: tcpdump started (PID $pid)"
}

traffic_debug_tcpdump_stop()
{
	local pidfile="${Z2K_TRAFFIC_DEBUG_PIDFILE:-${EXTRA_STRATS_DIR:-$ZAPRET_BASE/extra_strats}/cache/traffic/tcpdump.pid}"
	[ -f "$pidfile" ] || return 0

	local pid
	pid="$(cat "$pidfile" 2>/dev/null)"
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		echo "traffic debug: stopping tcpdump (PID $pid)"
		kill "$pid" 2>/dev/null || true
		sleep 1
		kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
	fi
	rm -f "$pidfile" 2>/dev/null || true
}
# ==============================================================================
# ��������� ����������� ��� KEENETIC
# ==============================================================================

PIDDIR=/var/run
USEROPT=""
[ -n "$WS_USER" ] && USEROPT="--user=$WS_USER"
NFQWS2="${NFQWS2:-$ZAPRET_BASE/nfq2/nfqws2}"

# Memory tier detection for the detectors' per-host failure map. The
# autocircular state map used to be capped here too, but the cap evicted
# settled working hosts in practice (users reported the rotator "forgetting"
# strategies) — it now grows unbounded, which costs at most a few MB on
# saturated routers and is worth it.
TOTAL_RAM_MB=$(awk '/^MemTotal:/ {print int($2/1024); exit}' /proc/meminfo 2>/dev/null)
[ -z "$TOTAL_RAM_MB" ] && TOTAL_RAM_MB=512
if [ "$TOTAL_RAM_MB" -lt 128 ]; then
    Z2K_DETECTOR_CAP=128
elif [ "$TOTAL_RAM_MB" -lt 384 ]; then
    Z2K_DETECTOR_CAP=256
else
    Z2K_DETECTOR_CAP=512
fi
export Z2K_DETECTOR_CAP

LUA_LIB="$ZAPRET_BASE/lua/zapret-lib.lua"
[ -f "$LUA_LIB" ] || LUA_LIB="$LUA_LIB.gz"
LUA_ANTIDPI="$ZAPRET_BASE/lua/zapret-antidpi.lua"
[ -f "$LUA_ANTIDPI" ] || LUA_ANTIDPI="$LUA_ANTIDPI.gz"
LUAOPT="--lua-init=@$LUA_LIB --lua-init=@$LUA_ANTIDPI"
LUA_AUTO="$ZAPRET_BASE/lua/zapret-auto.lua"
[ -f "$LUA_AUTO" ] || LUA_AUTO="$LUA_AUTO.gz"
[ -f "$LUA_AUTO" ] && LUAOPT="$LUAOPT --lua-init=@$LUA_AUTO"
# locked.lua (upstream'овский circular_locked) больше не загружается:
# orchestrator.sh удалён upstream'ом 2026-05-07, mechanism осиротел.
# Discord UDP теперь использует наш circular с allow_nohost (B1).
# Detectors must load BEFORE autocircular: the rotator resolves
# failure_detector=z2k_tls_stalled by global name when parsing profiles,
# so the functions need to exist already. Autocircular still references
# z2k_tls_alert_fatal via name-lookup after Phase 4 refactor.
# z2k-detectors.lua ВОЗВРАЩЁН 2026-05-30 (Этап 1 ревью-восстановления архива):
# кастомные детекторы (TLS-alert / HTTP-classifier / mid-stream-stall /
# silent-drop / server-active-reject). Грузятся ПОСЛЕ zapret-auto.lua
# (определяет standard_*_detector); резолвятся по имени через
# failure_detector=/success_detector= в профилях. На Этапе 1 — ТОЛЬКО
# загрузка (определения функций); проводка инъекций в config_official.sh
# приходит на Этапах 2-3, поэтому сейчас поведение не меняется.
LUA_Z2K_DETECTORS="$ZAPRET_BASE/lua/z2k-detectors.lua"
[ -f "$LUA_Z2K_DETECTORS" ] && LUAOPT="$LUAOPT --lua-init=@$LUA_Z2K_DETECTORS"
# Phase 6: z2k-fooling-ext.lua exports anti-ТСПУ fool functions like
# z2k_dynamic_ttl, referenced by strategies via `fool=<name>` arg. Must
# load after zapret-lib.lua (provides apply_fooling's extension point)
# and before autocircular strategies that reference the new fools.
LUA_Z2K_FOOLING="$ZAPRET_BASE/lua/z2k-fooling-ext.lua"
[ -f "$LUA_Z2K_FOOLING" ] && LUAOPT="$LUAOPT --lua-init=@$LUA_Z2K_FOOLING"
# Phase 7: z2k-range-rand.lua wraps upstream action functions (fake,
# multisplit, fakedsplit, …) so strategies can use `repeats=2-6` style
# range syntax on numeric args and get sticky per-flow randomised
# values. MUST load AFTER zapret-antidpi.lua where the wrapped
# functions are defined.
LUA_Z2K_RANGE_RAND="$ZAPRET_BASE/lua/z2k-range-rand.lua"
[ -f "$LUA_Z2K_RANGE_RAND" ] && LUAOPT="$LUAOPT --lua-init=@$LUA_Z2K_RANGE_RAND"
# z2k-autocircular.lua АРХИВИРОВАН 2026-05-28 (archive/custom-detectors-rotation/).
# Это была обёртка над нативным circular() (sticky-success / nld-pinning /
# silent-retry) — давала жалобы на «прыгающую/залипающую» ротацию. Откат на
# чистый нативный circular() из zapret-auto.lua (простая ротация fails→next).
LUA_Z2K_MODERN_CORE="$ZAPRET_BASE/lua/z2k-modern-core.lua"
[ -f "$LUA_Z2K_MODERN_CORE" ] && LUAOPT="$LUAOPT --lua-init=@$LUA_Z2K_MODERN_CORE"
# z2k-http-strats: 33 HTTP-bypass функций (z2k_http_*) портированных из
# ALFiX01/GoodbyeZapret custom_funcs.lua. Field-driven для расширения
# http_rkn arm (был 7 стратегий → стал ~40 с этим арсеналом). Подключение
# ПОСЛЕ z2k-modern-core.lua и перед autocircular инстансами.
LUA_Z2K_HTTP_STRATS="$ZAPRET_BASE/lua/z2k-http-strats.lua"
[ -f "$LUA_Z2K_HTTP_STRATS" ] && LUAOPT="$LUAOPT --lua-init=@$LUA_Z2K_HTTP_STRATS"
# z2k-state-persist.lua: persist-only layer over the NATIVE circular() —
# seeds nstrategy from state.tsv on load and saves it back when it changes
# (rate-limited, full-file rewrite). Does NOT change rotation logic. MUST be
# lua-init'd AFTER zapret-auto.lua (which defines circular) so it can wrap it.
LUA_Z2K_STATE_PERSIST="$ZAPRET_BASE/lua/z2k-state-persist.lua"
[ -f "$LUA_Z2K_STATE_PERSIST" ] && LUAOPT="$LUAOPT --lua-init=@$LUA_Z2K_STATE_PERSIST"
# z2k-dynamic-strategy.lua removed in r-15 Phase 1 — was a handler for
# the z2k-classify generator which is itself gone. New per-domain
# feedback lives in /opt/zapret2/lists/discovered-domains.txt (Phase 3).
#
# --bind-fix4/6: bind each raw-socket fake to the NFQUEUE-reported outgoing
# interface. Without it, on Keenetic with policy-based routing (NDM
# "маршрутизация по доменам" sending a domain into a WireGuard/VPN tunnel)
# the generated desync packets leak out the wrong interface (default-gw WAN)
# or get blocked in OUTPUT — corrupting the handshake, so a domain the user
# routes through a tunnel won't open while z2k is on (ntc.party #4181). For
# single-WAN / no-PBR setups it's a no-op: the fake already exits the default
# interface. The shipped nfqws2 supports both flags on every arch (verified).
NFQWS2_OPT_BASE="$USEROPT --fwmark=$DESYNC_MARK --bind-fix4 --bind-fix6 $LUAOPT"

# Phase 6B: C-level RST drop filter (necronicle/zapret2-z2k r1+).
# Default OFF: master does not run this filter, and field reports show
# Cloudflare can legitimately send pre-payload RSTs that this heuristic
# drops, turning a quick reconnect into a slow/no-load timeout.
# Opt in through /opt/zapret2/config:
#   RST_FILTER=1                -> --rst-filter=on
#   RST_FILTER=aggressive|agg   -> --rst-filter=aggressive
# The older xt_u32 IP-ID iptables rule (z2k_rst_filter_start/stop below)
# still lives behind DROP_DPI_RST=1 and complements this at raw PREROUTING.
RST_FILTER=${RST_FILTER:-0}
case "$RST_FILTER" in
    1|on|true|yes)
        NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --rst-filter=on"
        ;;
    aggressive|agg|aggro)
        NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --rst-filter=aggressive"
        ;;
esac

# Phase 9: IP block detection + client RST (necronicle/zapret2-z2k r5+).
# Watches outgoing ClientHello retransmits (upstream is_retransmission
# detector) and on the 3rd confirmed retrans synthesises a RST from
# server->client.
#
# DEFAULT OFF as of 2026-04-18. Rationale: ipblock's 3-retrans threshold
# fires BEFORE circular's rotator (`fails=3:retrans=2` needs 6 retrans)
# can accumulate enough failure signal to rotate to the next strategy.
# Result: client gets a RST and reconnects to the same strategy, same
# DPI block, same RST — infinite loop that looks to users like
# "rotation only works if I manually reload the page". Master's default
# of off, letting the TCP-retrans→circular path rotate automatically,
# matches the "rotation felt automatic" user experience we regressed.
#
# Opt-in via config flag IPBLOCK_DETECT=1 for users who specifically
# want the DNS-retry fast-fail behaviour (multi-A-record sites, where
# one IP is blocked and others work).
IPBLOCK_DETECT=${IPBLOCK_DETECT:-0}
[ "$IPBLOCK_DETECT" = "1" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --ipblock-detect=on"

# Load custom TLS ClientHello blob for strategies (manual: --blob is engine init option).
TLS_MAX_RU_BLOB="$ZAPRET_BASE/files/fake/tls_clienthello_max_ru.bin"
[ -s "$TLS_MAX_RU_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=tls_max_ru:@$TLS_MAX_RU_BLOB"

TLS_14_BLOB="$ZAPRET_BASE/files/fake/tls_clienthello_14.bin"
[ -s "$TLS_14_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=tls_clienthello_14:@$TLS_14_BLOB"

TLS_GOOGLE_BLOB="$ZAPRET_BASE/files/fake/tls_clienthello_www_google_com.bin"
[ -s "$TLS_GOOGLE_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=tls_clienthello_www_google_com:@$TLS_GOOGLE_BLOB"

TLS_STUN_BLOB="$ZAPRET_BASE/files/fake/stun.bin"
[ -s "$TLS_STUN_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=stun:@$TLS_STUN_BLOB"

TLS_4PDA_BLOB="$ZAPRET_BASE/files/fake/tls_clienthello_4pda_to.bin"
[ -s "$TLS_4PDA_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=tls_clienthello_4pda_to:@$TLS_4PDA_BLOB"

TLS_VK_BLOB="$ZAPRET_BASE/files/fake/tls_clienthello_vk_com.bin"
[ -s "$TLS_VK_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=tls_clienthello_vk_com:@$TLS_VK_BLOB"

TLS_GOSUSLUGI_BLOB="$ZAPRET_BASE/files/fake/tls_clienthello_gosuslugi_ru.bin"
[ -s "$TLS_GOSUSLUGI_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=tls_clienthello_gosuslugi_ru:@$TLS_GOSUSLUGI_BLOB"

TLS_ACTIVATED_BLOB="$ZAPRET_BASE/files/fake/tls_clienthello_activated.bin"
[ -s "$TLS_ACTIVATED_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=tls_clienthello_activated:@$TLS_ACTIVATED_BLOB"

SYN_PACKET_BLOB="$ZAPRET_BASE/files/fake/syn_packet.bin"
[ -s "$SYN_PACKET_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=syn_packet:@$SYN_PACKET_BLOB"

QUIC_GOOGLE_BLOB="$ZAPRET_BASE/files/fake/quic_initial_www_google_com.bin"
[ -s "$QUIC_GOOGLE_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=quic_google:@$QUIC_GOOGLE_BLOB"

QUIC5_BLOB="$ZAPRET_BASE/files/fake/quic_5.bin"
[ -s "$QUIC5_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=quic5:@$QUIC5_BLOB"

QUIC4_BLOB="$ZAPRET_BASE/files/fake/quic_4.bin"
[ -s "$QUIC4_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=quic4:@$QUIC4_BLOB"

QUIC6_BLOB="$ZAPRET_BASE/files/fake/quic_6.bin"
[ -s "$QUIC6_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=quic6:@$QUIC6_BLOB"

QUIC1_BLOB="$ZAPRET_BASE/files/fake/quic_1.bin"
[ -s "$QUIC1_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=quic1:@$QUIC1_BLOB"

QUIC_TEST_BLOB="$ZAPRET_BASE/files/fake/quic_test_00.bin"
[ -s "$QUIC_TEST_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=quic_test:@$QUIC_TEST_BLOB"

QUIC_RUTRACKER_BLOB="$ZAPRET_BASE/files/fake/quic_initial_rutracker_org.bin"
[ -s "$QUIC_RUTRACKER_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=quic_rutracker:@$QUIC_RUTRACKER_BLOB"

# Russian banking-cloud QUIC decoy from flowseal 1.9.8 (PR #12216) — used by the
# Discord UDP profile as a fake blob where the google-QUIC fingerprint is flagged.
QUIC_DBANKCLOUD_BLOB="$ZAPRET_BASE/files/fake/quic_initial_dbankcloud_ru.bin"
[ -s "$QUIC_DBANKCLOUD_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=quic_dbankcloud:@$QUIC_DBANKCLOUD_BLOB"

TLS_ONETRUST_BLOB="$ZAPRET_BASE/files/fake/tls_clienthello_www_onetrust_com.bin"
[ -s "$TLS_ONETRUST_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=tls_clienthello_www_onetrust_com:@$TLS_ONETRUST_BLOB"

TLS_T2_BLOB="$ZAPRET_BASE/files/fake/t2.bin"
[ -s "$TLS_T2_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=t2:@$TLS_T2_BLOB"

TLS_4PDA_SHORT_BLOB="$ZAPRET_BASE/files/fake/4pda.bin"
[ -s "$TLS_4PDA_SHORT_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=4pda:@$TLS_4PDA_SHORT_BLOB"

HTTP_IANA_BLOB="$ZAPRET_BASE/files/fake/http_iana_org.bin"
[ -s "$HTTP_IANA_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=http_iana:@$HTTP_IANA_BLOB"

ZERO_256_BLOB="$ZAPRET_BASE/files/fake/zero_256.bin"
[ -s "$ZERO_256_BLOB" ] && NFQWS2_OPT_BASE="$NFQWS2_OPT_BASE --blob=zero_256:@$ZERO_256_BLOB"

LISTS_DIR="$ZAPRET_BASE/lists"
EXTRA_STRATS_DIR="$ZAPRET_BASE/extra_strats"
CONFIG_DIR="/opt/etc/zapret2"
CUSTOM_DIR="${CUSTOM_DIR:-$ZAPRET_RW/init.d/keenetic}"
# ORCH_SCRIPT removed: upstream orchestrator.sh deleted 2026-05-07,
# Discord UDP rotation handled via our circular+allow_nohost (см. B1 plan).
IPSET_CR="$ZAPRET_BASE/ipset/create_ipset.sh"

# ==============================================================================
# ������� ��� ������ � IPSET
# ==============================================================================

create_ipset()
{
	echo "Creating ip list table (firewall type $FWTYPE)"
	"$IPSET_CR" "$@"
}

# ==============================================================================
# KEENETIC FIREWALL FUNCTIONS (������ OpenWrt network.sh ������������)
# ==============================================================================

get_default_ifaces4()
{
	exists ip || return 0
	# BusyBox `ip` IGNORES the `default` selector and prints the WHOLE routing
	# table, so the filtering has to happen HERE. Without it every LAN subnet
	# route contributed its device: on a live Keenetic this returned
	# "br0 br1 ppp0" instead of "ppp0", which put NFQUEUE rules on both LAN
	# bridges (3x the rules) and queued LAN-to-LAN traffic into nfqws2 for
	# nothing. Verified on the box: `ip route show default` printed
	# "192.168.1.0/24 dev br0" and "10.1.30.0/24 dev br1" alongside the real
	# default. iproute2 honours the selector, so this is a no-op there.
	ip route show default 2>/dev/null | awk '
		$1!="default" && $1!="0.0.0.0/0" { next }
		{ for (i=1;i<=NF;i++) if ($i=="dev") print $(i+1) }
	' | xargs
}

get_default_ifaces6()
{
	exists ip || return 0
	# Same BusyBox selector bug as get_default_ifaces4 - filter here.
	ip -6 route show default 2>/dev/null | awk '
		$1!="default" && $1!="::/0" { next }
		{ for (i=1;i<=NF;i++) if ($i=="dev") print $(i+1) }
	' | xargs
}

get_wan_ifaces4()
{
	local ifaces
	if [ -n "$WAN_IFACE" ]; then
		ifaces="$(echo "$WAN_IFACE" | tr ',' ' ')"
	else
		ifaces="$(get_default_ifaces4)"
	fi
	ifaces="$(echo "$ifaces" | xargs)"
	if [ -n "$ifaces" ] && exists ip; then
		local i
		for i in $ifaces; do
			# /sys (не netlink) — `ip link show` виснет в D-state на WireGuard nwg0 под штормом (issue #18)
			[ -e "/sys/class/net/$i" ] || echo "WARN: WAN iface '$i' not found"
		done
	fi
	[ -n "$ifaces" ] && unique $ifaces || true
}

get_wan_ifaces6()
{
	local ifaces
	if [ -n "$WAN_IFACE" ]; then
		ifaces="$(echo "$WAN_IFACE" | tr ',' ' ')"
	else
		ifaces="$(get_default_ifaces6)"
	fi
	ifaces="$(echo "$ifaces" | xargs)"
	if [ -n "$ifaces" ] && exists ip; then
		local i
		for i in $ifaces; do
			# /sys (не netlink) — `ip link show` виснет в D-state на WireGuard nwg0 под штормом (issue #18)
			[ -e "/sys/class/net/$i" ] || echo "WARN: WAN iface '$i' not found"
		done
	fi
	[ -n "$ifaces" ] && unique $ifaces || true
}

# Keenetic-specific: ���������� ������ fw_nfqws_post4/post6/pre4/pre6
# � ������� �� OpenWrt, �� ������� network.sh � ����������� WAN �����������
# �������� ���������� WAN �� default route

fw_nfqws_post4()
{
	# $1 - 1 - add, 0 - del
	# $2 - filter
	# $3 - queue number
	local wan
	wan="$(get_wan_ifaces4)"
	if [ -n "$wan" ]; then
		_fw_nfqws_post4 "$1" "$2" "$3" "$wan"
	else
		echo "WARN: WAN iface not found (IPv4), skip applying nfqws rules"
		return 0
	fi
}

fw_nfqws_post6()
{
	# $1 - 1 - add, 0 - del
	# $2 - filter
	# $3 - queue number
	[ "$DISABLE_IPV6" = "1" ] && return 0
	local wan
	wan="$(get_wan_ifaces6)"
	if [ -n "$wan" ]; then
		_fw_nfqws_post6 "$1" "$2" "$3" "$wan"
	else
		echo "WARN: WAN iface not found (IPv6), skip applying nfqws rules"
		return 0
	fi
}

fw_nfqws_pre4()
{
	# $1 - 1 - add, 0 - del
	# $2 - filter
	# $3 - queue number
	local wan
	wan="$(get_wan_ifaces4)"
	if [ -n "$wan" ]; then
		_fw_nfqws_pre4 "$1" "$2" "$3" "$wan"
	else
		echo "WARN: WAN iface not found (IPv4), skip applying nfqws rules"
		return 0
	fi
}

fw_nfqws_pre6()
{
	# $1 - 1 - add, 0 - del
	# $2 - filter
	# $3 - queue number
	[ "$DISABLE_IPV6" = "1" ] && return 0
	local wan
	wan="$(get_wan_ifaces6)"
	if [ -n "$wan" ]; then
		_fw_nfqws_pre6 "$1" "$2" "$3" "$wan"
	else
		echo "WARN: WAN iface not found (IPv6), skip applying nfqws rules"
		return 0
	fi
}

# ==============================================================================
# ������� ���������� DAEMON (������������ ��� KEENETIC ��� PROCD)
# ==============================================================================

run_daemon()
{
    # $1 - daemon ID
    # $2 - daemon binary
    # $3 - daemon args
    local DAEMONBASE
    DAEMONBASE="$(basename "$2")"
    local PIDFILE="$PIDDIR/${DAEMONBASE}_$1.pid"

    echo "Starting daemon $1: $2 $3"

    # ������ � ���� � ����������� PID
    $2 $3 >/dev/null 2>&1 &
    local PID=$!

    # ��������� PID
    echo $PID > "$PIDFILE"

    # ��������� ��� ������� ����������
    # Which queue THIS daemon was told to bind. custom.d instances
    # (50-stun4all, 50-discord-media) pass their own --qnum, so the global
    # $QNUM is simply wrong for them - we would wait on the main daemon's
    # queue, find it already bound, and return without ever checking this one.
    local _qn="$QNUM"
    case " $3 " in
        *" --qnum="*) _qn=${3#*--qnum=}; _qn=${_qn%% *} ;;
    esac
    case "$DAEMONBASE" in
        nfqws2) z2k_wait_queue_bound "$PID" "${_qn:-200}" 3 ;;
        *)      sleep 1 ;;
    esac
    # No extra settle here on purpose. A successful z2k_wait_queue_bound already
    # proves this pid got through option parsing, lua init, blob loading AND bound
    # its own queue - a strictly stronger start check than the old flat `sleep 1`,
    # which verified nothing. It also returns 1 the moment the pid dies mid-wait,
    # so a failed start is still caught below. The only case a settle would add is
    # "bound the queue, then crashed milliseconds later", which is a runtime crash
    # for the watchdog, not a startup failure - and paying 200 ms (a full second
    # where usleep is absent) on every daemon start to maybe notice it is a bad
    # trade in the path this whole change exists to shorten.
    if z2k_pid_running "$PID"; then
        echo "Daemon $1 started with PID $PID"
        return 0
    else
        echo "ERROR: Daemon $1 failed to start"
        rm -f "$PIDFILE"
        return 1
    fi
}

run_nfqws()
{
    # $1 - instance ID
    # $2 - nfqws options
    # No hostlist validation here — custom.d scripts (50-stun4all, 50-discord-media)
    # intentionally run without hostlists, relying on firewall rules (u32/nft @ih).
    # Hostlist checks happen at config generation time (add_hostlist_line in config_official.sh).
    #
    # Keep engine rotation CONSISTENT with the detector wiring actually present in
    # these args. If the profiles still carry custom failure/success detectors
    # (Z2K_NATIVE_DETECTORS=0 legacy mode), the engine MUST keep the r-49
    # proof-of-life/dominance offset — else those detectors' false-failures would
    # rotate working hosts. Pure-native profiles (the default) get pure-native
    # rotation (POL off), so a real RST/retrans is never drowned. Deriving it from
    # the args (not a separate flag) makes the two impossible to desync.
    case " $NFQWS2_OPT_BASE $2 " in
        *failure_detector=*|*success_detector=*) export Z2K_NATIVE_ROTATION=0 ;;
        *)                                       export Z2K_NATIVE_ROTATION=1 ;;
    esac
    run_daemon $1 "$NFQWS2" "$NFQWS2_OPT_BASE $2"
}

do_nfqws()
{
    # $1 - 0 (stop) or 1 (start)
    # $2 - instance ID
    # $3 - nfqws options
    [ "$1" = 0 ] || { shift; run_nfqws "$@"; }
}

stop_daemon_by_pidfile()
{
    # $1 - pidfile path
    if [ -f "$1" ]; then
        local PID
        PID=$(cat "$1")
        if [ -n "$PID" ] && kill -0 $PID 2>/dev/null; then
            echo "Stopping daemon with PID $PID"
            kill $PID 2>/dev/null
            # Poll instead of a flat 3 s: nfqws2 exits on SIGTERM in ~0.05 s
            # (measured) because nfqws.c checks bQuit right after select().
            # Same 3 s SIGKILL deadline, just not paid when it is not needed.
            z2k_wait_gone "$PID" 3
            # Force kill ���� �� �����������
            kill -0 $PID 2>/dev/null && kill -9 $PID 2>/dev/null
        fi
        rm -f "$1"
    fi
}

stop_all_nfqws()
{
    echo "Stopping all nfqws daemons"

    # ���������� �� PID ������
    for pidfile in $PIDDIR/nfqws2_*.pid; do
        [ -f "$pidfile" ] && stop_daemon_by_pidfile "$pidfile"
    done

    # Fallback: killall ���� ���-�� ��������
    killall nfqws2 2>/dev/null

    # �������� ��� PID �����
    rm -f $PIDDIR/nfqws2_*.pid 2>/dev/null
}

# ==============================================================================
# ������� START/STOP DAEMONS
# ==============================================================================

start_daemons()
{
    echo "Starting zapret2 daemons"

    ensure_autocircular_files

    # ������������ ������� �� common/linux_daemons.sh
    # standard_mode_daemons �������� do_nfqws
    standard_mode_daemons 1

    # ��������� custom scripts ���� ����
    custom_runner zapret_custom_daemons 1

    repair_autocircular_files_after_daemon_start

    return 0
}

stop_daemons()
{
    echo "Stopping zapret2 daemons"

    # ���������� ��� nfqws ��������
    stop_all_nfqws

    # ��������� custom scripts ��� ���������
    custom_runner zapret_custom_daemons 0

    return 0
}

restart_daemons()
{
    stop_daemons
    sleep 2
    start_daemons
}

# ==============================================================================
# ������� START/STOP FIREWALL
# ==============================================================================

# Where the FIRMWARE keeps its modules.
#
# `modprobe` here is Entware's (/opt/sbin/modprobe) and it searches
# /opt/lib/modules/<kver> — a directory Keenetic does not have at all. Verified on
# a live 4.9-ndm-5 box:
#     modprobe: FATAL: Module xt_multiport not found in directory /opt/lib/modules/4.9-ndm-5
# so this step never actually loaded anything on any router. It only LOOKED fine
# where NDM had already loaded the module for its own rules.
#
# The kernel cannot cover for us either: /proc/sys/kernel/modprobe is EMPTY and
# /sbin/modprobe does not exist, so there is no on-demand autoload. Verified live:
# inserting a rule whose match is not loaded fails with "No chain/target/match by
# that name" and the module does NOT appear. A missing module therefore means the
# RULE IS NEVER INSTALLED — for connbytes that is the packet-direction filter on
# the NFQUEUE rules, for multiport the PPE de-offload — so the bypass degrades in
# silence while the log says only "may be built-in".
#
# Two layouts are in the field: /lib/modules/<kver> (4.9-ndm-5) and
# /lib/system-modules/<kver> (NDMS 5.1.2, reported on an NC1812). Check both, then
# fall back to a search bounded to /lib — never /opt, where a stale copy from a
# different kernel would be the wrong ABI.
Z2K_MODDIRS=
z2k_module_dirs()
{
    local kv d
    if [ -z "$Z2K_MODDIRS" ]; then
        kv=$(uname -r 2>/dev/null)
        for d in "/lib/modules/$kv" "/lib/system-modules/$kv" /lib/modules /lib/system-modules; do
            [ -d "$d" ] && Z2K_MODDIRS="$Z2K_MODDIRS $d"
        done
    fi
    echo "$Z2K_MODDIRS"
}

# insmod $1 from the firmware tree. 0 only if a .ko was found AND accepted.
z2k_insmod_fw()
{
    local m="$1" d f
    for d in $(z2k_module_dirs); do
        f="$d/$m.ko"
        [ -f "$f" ] && insmod "$f" 2>/dev/null && return 0
    done
    f=$(find /lib -name "$m.ko" -type f 2>/dev/null | head -1)
    [ -n "$f" ] && insmod "$f" 2>/dev/null && return 0
    return 1
}

# Does the capability this module provides actually exist? Asked of the kernel's
# own registry, NOT of lsmod: on stock firmware most of these are built in, where
# lsmod never lists them and "failed to load" is pure noise — which is exactly the
# wall of warnings that buried the one real failure in a field report.
z2k_module_present()
{
    case "$1" in
        xt_multiport)    grep -qw multiport /proc/net/ip_tables_matches 2>/dev/null ;;
        xt_connbytes)    grep -qw connbytes /proc/net/ip_tables_matches 2>/dev/null ;;
        xt_connmark)     grep -qw connmark  /proc/net/ip_tables_matches 2>/dev/null ;;
        xt_CONNMARK)     grep -qw CONNMARK  /proc/net/ip_tables_targets 2>/dev/null ;;
        xt_NFQUEUE)      grep -qw NFQUEUE   /proc/net/ip_tables_targets 2>/dev/null ;;
        nfnetlink_queue) [ -e /proc/net/netfilter/nfnetlink_queue ] ;;
        *)               lsmod 2>/dev/null | grep -q "^$1 " ;;
    esac
}

load_modules()
{
    echo "Loading required kernel modules"

    # ������ ����������� ������� ��� ������ zapret2
    #
    # xt_CONNMARK/xt_connmark serve one feature — Keenetic policy exclusion — and it
    # is safe to enable only because z2k_policy_connmark_start now refuses to install
    # its rule for a policy with no member hosts. Without that guard, making these
    # modules loadable would resurrect the rule on firmware where the .ko exists but
    # was not loaded, and in the default "only policy traffic" mode a memberless
    # policy puts the exclude bit on EVERY connection — bypass gone. That is the p-59
    # accident, and it is what the member guard exists to prevent. Do not load these
    # without it.
    local modules="xt_multiport xt_connbytes xt_NFQUEUE nfnetlink_queue xt_CONNMARK xt_connmark"

    for module in $modules; do
        # Built in, or already loaded: nothing to do and nothing to say.
        if z2k_module_present "$module"; then
            [ -n "$Z2K_DEBUG" ] && echo "DEBUG: Module already available: $module"
            continue
        fi
        [ -n "$Z2K_DEBUG" ] && echo "DEBUG: Loading module: $module"
        modprobe "$module" 2>/dev/null
        z2k_module_present "$module" && continue
        z2k_insmod_fw "$module"
        # Warn ONLY when the capability is still missing after both attempts —
        # then it is a real absence, not a modprobe that looked in the wrong place.
        z2k_module_present "$module" || \
            echo "Warning: $module is not available in this firmware — rules that need it will not be installed"
    done

    # Same treatment for the ipset bitmap:port module. This used to be the only
    # place that knew Entware's modprobe cannot find firmware modules, and it
    # hardcoded /lib/modules/<kver> — which is the path that does NOT exist on the
    # firmware where this problem was actually reported.
    #
    # Then ask whether the TYPE actually works, which is not the same question as
    # whether the module loaded: bitmap:port can be built into the kernel with no
    # .ko to find, and it can equally be absent from the firmware altogether. Only
    # creating a set tells them apart. Worth the two ipset calls once per start,
    # because zport_tcp/zport_udp gate EVERY nfqws rule and the engine has no
    # --dport fallback — an unavailable type means no bypass at all, and it used to
    # surface only as a wall of raw "Set zport_tcp doesn't exist" from iptables
    # with nothing pointing at the cause (issue #27, NDMS 5.1.2).
    if ! lsmod 2>/dev/null | grep -q "^ip_set_bitmap_port "; then
        z2k_insmod_fw ip_set_bitmap_port || true
    fi
    if command -v ipset >/dev/null 2>&1; then
        ipset destroy z2k_probe_bitmap 2>/dev/null
        if ipset create z2k_probe_bitmap bitmap:port range 0-65535 2>/dev/null; then
            ipset destroy z2k_probe_bitmap 2>/dev/null
        else
            echo "WARNING: ipset type bitmap:port is not available in this firmware"
            echo "zport_tcp/zport_udp cannot be created, so NO nfqws rules will be installed and the packet-level bypass will not work"
        fi
    fi

    # nfnetlink_queue is the one that must genuinely be there — without it nfqws2
    # cannot bind a queue at all. Ask the kernel, not `modinfo`: modinfo is the same
    # Entware tool as modprobe and searches the same nonexistent /opt/lib/modules,
    # so on a firmware where this module is BUILT IN it answers "no" and this gate
    # would abort a perfectly working router.
    if ! z2k_module_present nfnetlink_queue; then
        echo "WARNING: nfnetlink_queue module not available!"
        echo "nfqws2 may fail with 'Operation not permitted'"
        return 1
    fi

    echo "Kernel modules loaded"
    return 0
}


# Keenetic fix (similar to nfqws2-keenetic): ensure UDP packets processed by nfqws2
# (marked with DESYNC_MARK) still get source NAT on WAN via a dedicated nat chain.
Z2K_IPT_NAT_CHAIN="zapret2_nat"

# Connmark-based exclusion (borrowed from nfqws2-keenetic):
# - Mark connections outside selected Keenetic policy (POLICY_NAME/POLICY_EXCLUDE) with CONNMARK exclude bit.
# - NFQUEUE rules include "-m connmark ! --mark $Z2K_CONNMARK_EXCLUDE" so excluded flows never enter NFQUEUE.
Z2K_CONNMARK_EXCLUDE="0x20000000/0x20000000"
Z2K_CONNMARK_OK4=0
Z2K_CONNMARK_OK6=0
Z2K_POLICY_MARK=""

iptablesw()
{
    # Prefer -w (xtables lock wait). Fallback without -w for older iptables.
    iptables -w "$@" 2>/dev/null || iptables "$@" 2>/dev/null
}

ip6tablesw()
{
    ip6tables -w "$@" 2>/dev/null || ip6tables "$@" 2>/dev/null
}

z2k_connmark_check_avail4()
{
    grep -qw connmark /proc/net/ip_tables_matches 2>/dev/null || return 1
    grep -qw CONNMARK /proc/net/ip_tables_targets 2>/dev/null || return 1
    return 0
}

z2k_connmark_check_avail6()
{
    grep -qw connmark /proc/net/ip6_tables_matches 2>/dev/null || return 1
    grep -qw CONNMARK /proc/net/ip6_tables_targets 2>/dev/null || return 1
    return 0
}

z2k_connmark_init()
{
    Z2K_CONNMARK_OK4=0
    Z2K_CONNMARK_OK6=0

    [ "$FWTYPE" = "iptables" ] || return 0

    # Try to load connmark modules (may be built-in).
    modprobe xt_CONNMARK 2>/dev/null || true
    modprobe xt_connmark 2>/dev/null || true

    exists iptables && z2k_connmark_check_avail4 && Z2K_CONNMARK_OK4=1
    [ "$DISABLE_IPV6" = "1" ] && return 0
    exists ip6tables && z2k_connmark_check_avail6 && Z2K_CONNMARK_OK6=1
}

z2k_detect_policy_mark()
{
    Z2K_POLICY_MARK=""

    # Default to nfqws2-keenetic convention. If policy doesn't exist, we process all traffic.
    POLICY_NAME="${POLICY_NAME:-nfqws}"
    POLICY_EXCLUDE="${POLICY_EXCLUDE:-0}"

    # ndmc exists on Keenetic firmware (outside Entware). Use /bin/ndmc when present.
    local ndmc_bin="ndmc"
    [ -x /bin/ndmc ] && ndmc_bin="/bin/ndmc"
    command -v "$ndmc_bin" >/dev/null 2>&1 || return 1

    # Extract policy mark by description (handle quotes and "mark:" vs "mark =").
    local mark
    # LD_LIBRARY_PATH= обязателен: на KeenOS 4.3+/5.x в окружении сервиса
    # LD_LIBRARY_PATH содержит Entware /opt/lib, ndmc грузит чужой OpenSSL и
    # падает 0xcffd0060 -> пустой вывод -> mark пустой -> return 1 -> правило
    # исключения не ставится МОЛЧА (webpanel actions.sh при этом показывает
    # «политика найдена», т.к. ТАМ сброс есть). См. install.sh:241.
    mark="$(LD_LIBRARY_PATH= "$ndmc_bin" -c "show ip policy" 2>/dev/null | awk -v name="$POLICY_NAME" '
        function trim(s) { sub(/^[ \t\r\n]+/, "", s); sub(/[ \t\r\n]+$/, "", s); return s }
        function unquote(s) {
            s=trim(s)
            if (s ~ /^\".*\"$/) { sub(/^\"/, "", s); sub(/\"$/, "", s) }
            return s
        }
        function rm_trailing_colon(s) { sub(/:+$/, "", s); return s }
        BEGIN { found=0; want=rm_trailing_colon(tolower(name)) }
        {
            line=tolower($0)
            if (line ~ /description[ \t]*=/) {
                desc=$0
                sub(/.*description[ \t]*=[ \t]*/, "", desc)
                # Same ordering trap as z2k_policy_id: strip the trailing colon FIRST,
                # or a QUOTED description never matches and the policy is not found at all.
                # trim FIRST: the line ends "X: " with a trailing space, so stripping
                # the colon before trimming does nothing. See z2k_policy_id.
                desc=tolower(unquote(rm_trailing_colon(trim(desc))))
                found = (desc == want) ? 1 : 0
                next
            }
            if (found && line ~ /mark[ \t]*[:=]/) {
                m=$0
                sub(/.*mark[ \t]*[:=][ \t]*/, "", m)
                m=unquote(m)
                split(m, a, /[ \t\r\n]+/)
                print a[1]
                exit
            }
        }
    ')"

    mark="${mark%%/*}"
    mark="${mark%%;*}"
    mark="${mark#0x}"
    mark="${mark#0X}"
    case "$mark" in
        ""|*[!0-9a-fA-F]*)
            return 1
            ;;
    esac

    Z2K_POLICY_MARK="0x${mark}/0x0fffffff"
    return 0
}

# Which ndmc to run. Firmware ndmc lives outside Entware; LD_LIBRARY_PATH= is
# mandatory at every call site (Entware's OpenSSL makes it die 0xcffd0060).
z2k_ndmc_bin()
{
    if [ -x /bin/ndmc ]; then echo /bin/ndmc
    elif command -v ndmc >/dev/null 2>&1; then echo ndmc
    else return 1; fi
}

# The NDM policy NAME (Policy0, z2ktest, ...). POLICY_NAME is matched against the
# DESCRIPTION, but `show ip hotspot` reports membership by NAME, so both are needed:
# the description to find the policy the user configured, the name to count who is
# actually in it. Both live on the same line of `show ip policy`:
#     policy, name = z2ktest, description = z2k-test-temp:
z2k_policy_id()
{
    local nb="$1"
    LD_LIBRARY_PATH= "$nb" -c "show ip policy" 2>/dev/null | awk -v want="$2" '
        function trim(s) { sub(/^[ \t\r\n]+/, "", s); sub(/[ \t\r\n]+$/, "", s); return s }
        function unq(s)  { s=trim(s); if (s ~ /^".*"$/) { sub(/^"/, "", s); sub(/"$/, "", s) } return s }
        function rmc(s)  { sub(/:+$/, "", s); return s }
        BEGIN { w = rmc(tolower(want)) }
        /description[ \t]*=/ {
            # rmc BEFORE unq: the box prints `description = "x":`, so the trailing
            # colon sits OUTSIDE the closing quote and unquoting first matches nothing.
            # trim -> rmc -> unq, in that order. The box prints `description = X: `
            # WITH A TRAILING SPACE, so stripping the colon before trimming is a no-op
            # and nothing ever matches; and the colon sits outside the closing quote,
            # so unquoting before stripping it is a no-op too. Both were live bugs.
            d=$0; sub(/.*description[ \t]*=[ \t]*/, "", d); d=tolower(unq(rmc(trim(d))))
            if (d != w) next
            n=$0; sub(/.*name[ \t]*=[ \t]*/, "", n); split(n, p, ","); print trim(p[1]); exit
        }'
}

# How many hosts are bound to that policy. `show ip hotspot` prints one
# "policy: <name>" per host, empty for hosts in no policy.
z2k_policy_members()
{
    local nb="$1"
    LD_LIBRARY_PATH= "$nb" -c "show ip hotspot" 2>/dev/null | awk -v id="$2" '
        /^[ \t]*policy[ \t]*:/ {
            v=$0; sub(/.*policy[ \t]*:[ \t]*/, "", v); gsub(/[ \t\r]/, "", v)
            if (v != "" && v == id) c++
        }
        END { print c+0 }'
}

z2k_policy_connmark_start()
{
    [ "$FWTYPE" = "iptables" ] || return 0
    [ "$Z2K_CONNMARK_OK4" = "1" ] || return 0

    z2k_detect_policy_mark || return 0

    # THE MEMBER GUARD, and the reason this feature killed bypasses in the field.
    #
    # Measured on a live router (2026-07-26, policy z2ktest, one member): traffic
    # from a policy member carries the policy mark at mangle POSTROUTING on EVERY
    # packet (1013/1013 matched mark ffffaab/0x0fffffff), while traffic outside any
    # policy carries mark 0. So the mechanism and the hook are right — the earlier
    # conclusion that the mark "does not survive to POSTROUTING" was measured
    # without a member in the policy and was wrong.
    #
    # What is NOT right is the default. POLICY_NAME defaults to "nfqws" and
    # POLICY_EXCLUDE defaults to 0, i.e. "process ONLY policy traffic", which is
    # implemented as "put the exclude bit on everything that is NOT in the policy".
    # If such a policy exists but has NO member hosts, that is every connection on
    # the router: NFQUEUE then processes nobody and the bypass dies completely,
    # silently. That is the reported failure — the user's bypass came back the
    # moment they deleted the policy.
    #
    # A policy with no members cannot express an intent either way, so install
    # nothing and say so.
    local nb pid members
    nb=$(z2k_ndmc_bin) || return 0
    pid=$(z2k_policy_id "$nb" "$POLICY_NAME")
    if [ -z "$pid" ]; then
        echo "Policy '$POLICY_NAME': cannot read its NDM name — not installing the exclusion rule"
        return 0
    fi
    members=$(z2k_policy_members "$nb" "$pid")
    case "$members" in ''|*[!0-9]*) members=0 ;; esac
    if [ "$members" -lt 1 ]; then
        echo "Policy '$POLICY_NAME' ($pid) has no member hosts — not installing the exclusion rule."
        echo "  Assign devices to that policy in the Keenetic web UI, or the rule would"
        echo "  exclude ALL traffic from processing and the bypass would stop working."
        return 0
    fi
    echo "Policy '$POLICY_NAME' ($pid): $members member host(s)."

    local pol_rule=""
    if [ "$POLICY_EXCLUDE" = "1" ]; then
        echo "Found policy '$POLICY_NAME'. Traffic from it will be excluded from processing."
        pol_rule="-m mark --mark $Z2K_POLICY_MARK -j CONNMARK --set-xmark $Z2K_CONNMARK_EXCLUDE"
    else
        echo "Found policy '$POLICY_NAME'. Only traffic from it will be processed."
        pol_rule="-m mark ! --mark $Z2K_POLICY_MARK -j CONNMARK --set-xmark $Z2K_CONNMARK_EXCLUDE"
    fi

    local wan iface
    wan="$(get_wan_ifaces4)"
    [ -n "$wan" ] || return 0

    for iface in $wan; do
        # Exclude connections outside policy by setting CONNMARK bit before NFQUEUE rules.
        iptablesw -t mangle -C POSTROUTING -o "$iface" $pol_rule || iptablesw -t mangle -I POSTROUTING -o "$iface" $pol_rule
    done

    [ "$Z2K_CONNMARK_OK6" = "1" ] || return 0

    wan="$(get_wan_ifaces6)"
    [ -n "$wan" ] || return 0

    for iface in $wan; do
        ip6tablesw -t mangle -C POSTROUTING -o "$iface" $pol_rule || ip6tablesw -t mangle -I POSTROUTING -o "$iface" $pol_rule
    done
}

z2k_policy_connmark_stop()
{
    [ "$FWTYPE" = "iptables" ] || return 0
    [ "$Z2K_CONNMARK_OK4" = "1" ] || return 0

    z2k_detect_policy_mark || return 0

    local pol_rule=""
    if [ "$POLICY_EXCLUDE" = "1" ]; then
        pol_rule="-m mark --mark $Z2K_POLICY_MARK -j CONNMARK --set-xmark $Z2K_CONNMARK_EXCLUDE"
    else
        pol_rule="-m mark ! --mark $Z2K_POLICY_MARK -j CONNMARK --set-xmark $Z2K_CONNMARK_EXCLUDE"
    fi

    local wan iface
    wan="$(get_wan_ifaces4)"
    [ -n "$wan" ] || return 0

    for iface in $wan; do
        while iptablesw -t mangle -C POSTROUTING -o "$iface" $pol_rule 2>/dev/null; do
            iptablesw -t mangle -D POSTROUTING -o "$iface" $pol_rule || break
        done
    done

    [ "$Z2K_CONNMARK_OK6" = "1" ] || return 0

    wan="$(get_wan_ifaces6)"
    [ -n "$wan" ] || return 0

    for iface in $wan; do
        while ip6tablesw -t mangle -C POSTROUTING -o "$iface" $pol_rule 2>/dev/null; do
            ip6tablesw -t mangle -D POSTROUTING -o "$iface" $pol_rule || break
        done
    done
}

# Override zapret2 iptables NFQUEUE rule builders to respect connmark exclusion.
# This keeps rule semantics identical to upstream, adding only "-m connmark ! --mark $Z2K_CONNMARK_EXCLUDE".
_fw_nfqws_post4()
{
    # $1 - 1 - add, 0 - del
    # $2 - iptable filter for ipv4
    # $3 - queue number
    # $4 - wan interface names space separated
    [ "$DISABLE_IPV4" = "1" ] || [ -z "$2" ] || {
        local i rule connchk=""

        ipt_print_op $1 "$2" "nfqws postrouting (qnum $3)"

        [ "$Z2K_CONNMARK_OK4" = "1" ] && connchk="-m connmark ! --mark $Z2K_CONNMARK_EXCLUDE"

        rule="$(ipt_mark_filter) $connchk -m mark ! --mark $DESYNC_MARK/$DESYNC_MARK $2 $IPSET_EXCLUDE dst -j NFQUEUE --queue-num $3 --queue-bypass"
        if [ -n "$4" ] ; then
            for i in $4; do
                ipt_add_del $1 POSTROUTING -t mangle -o $i $rule
            done
        else
            ipt_add_del $1 POSTROUTING -t mangle $rule
        fi
    }
}

_fw_nfqws_post6()
{
    # $1 - 1 - add, 0 - del
    # $2 - iptable filter for ipv6
    # $3 - queue number
    # $4 - wan interface names space separated
    [ "$DISABLE_IPV6" = "1" ] || [ -z "$2" ] || {
        local i rule connchk=""

        ipt_print_op $1 "$2" "nfqws postrouting (qnum $3)" 6

        [ "$Z2K_CONNMARK_OK6" = "1" ] && connchk="-m connmark ! --mark $Z2K_CONNMARK_EXCLUDE"

        rule="$(ipt_mark_filter) $connchk -m mark ! --mark $DESYNC_MARK/$DESYNC_MARK $2 $IPSET_EXCLUDE6 dst -j NFQUEUE --queue-num $3 --queue-bypass"
        if [ -n "$4" ] ; then
            for i in $4; do
                ipt6_add_del $1 POSTROUTING -t mangle -o $i $rule
            done
        else
            ipt6_add_del $1 POSTROUTING -t mangle $rule
        fi
    }
}

_fw_nfqws_pre4()
{
    # $1 - 1 - add, 0 - del
    # $2 - iptable filter for ipv4
    # $3 - queue number
    # $4 - wan interface names space separated
    [ "$DISABLE_IPV4" = "1" ] || [ -z "$2" ] || {
        local i rule connchk=""

        ipt_print_op $1 "$2" "nfqws input+forward (qnum $3)"

        # Do NOT connmark-exclude on the REPLY/incoming rule. Z2K_CONNMARK_EXCLUDE
        # (0x20000000) collides with zapret2's own DESYNC_MARK_POSTNAT and the NDM
        # mark — both set ON the bypass-target connection by reply time — so an
        # exclude here drops the incoming DPI RST/ServerHello of the very hosts we
        # desync, and the rotator never sees the failure (0 incoming -> never
        # rotates). Device-policy exclusion is enforced on the OUTGOING (post)
        # rule, which is sufficient. connchk stays "" here on purpose.

        rule="$connchk $2 $IPSET_EXCLUDE src -j NFQUEUE --queue-num $3 --queue-bypass"
        if [ -n "$4" ] ; then
            for i in $4; do
                # iptables PREROUTING chain is before NAT. not possible to have DNATed ip's there
                ipt_add_del $1 INPUT -t mangle -i $i $rule
                ipt_add_del $1 FORWARD -t mangle -i $i $rule
            done
        else
            ipt_add_del $1 INPUT -t mangle $rule
            ipt_add_del $1 FORWARD -t mangle $rule
        fi
    }
}

_fw_nfqws_pre6()
{
    # $1 - 1 - add, 0 - del
    # $2 - iptable filter for ipv6
    # $3 - queue number
    # $4 - wan interface names space separated
    [ "$DISABLE_IPV6" = "1" ] || [ -z "$2" ] || {
        local i rule connchk=""

        ipt_print_op $1 "$2" "nfqws input+forward (qnum $3)" 6

        # See _fw_nfqws_pre4: no connmark-exclude on the reply rule (the exclude
        # bit collides with DESYNC_MARK_POSTNAT/NDM and would drop the incoming
        # RST of bypass targets). connchk stays "" here on purpose.

        rule="$connchk $2 $IPSET_EXCLUDE6 src -j NFQUEUE --queue-num $3 --queue-bypass"
        if [ -n "$4" ] ; then
            for i in $4; do
                # iptables PREROUTING chain is before NAT. not possible to have DNATed ip's there
                ipt6_add_del $1 INPUT -t mangle -i $i $rule
                ipt6_add_del $1 FORWARD -t mangle -i $i $rule
            done
        else
            ipt6_add_del $1 INPUT -t mangle $rule
            ipt6_add_del $1 FORWARD -t mangle $rule
        fi
    }
}

z2k_udp_masquerade_fix_start()
{
    [ "$FWTYPE" = "iptables" ] || return 0
    exists iptables || return 0

    local wan iface
    wan="$(get_wan_ifaces4)"
    [ -n "$wan" ] || {
        [ -n "$Z2K_DEBUG" ] && echo "DEBUG: UDP masquerade fix: WAN iface not found, skip"
        return 0
    }

    local mark="${DESYNC_MARK:-0x40000000}"
    local mark_processed="${mark}/${mark}"

    iptablesw -t nat -N "$Z2K_IPT_NAT_CHAIN"
    iptablesw -t nat -F "$Z2K_IPT_NAT_CHAIN"
    iptablesw -t nat -C POSTROUTING -j "$Z2K_IPT_NAT_CHAIN" || iptablesw -t nat -A POSTROUTING -j "$Z2K_IPT_NAT_CHAIN"

    for iface in $wan; do
        iptablesw -t nat -A "$Z2K_IPT_NAT_CHAIN" -o "$iface" -m mark --mark "$mark_processed" -p udp -j MASQUERADE
    done
}

z2k_udp_masquerade_fix_stop()
{
    [ "$FWTYPE" = "iptables" ] || return 0
    exists iptables || return 0

    while iptablesw -t nat -C POSTROUTING -j "$Z2K_IPT_NAT_CHAIN" 2>/dev/null; do
        iptablesw -t nat -D POSTROUTING -j "$Z2K_IPT_NAT_CHAIN" || break
    done

    iptablesw -t nat -F "$Z2K_IPT_NAT_CHAIN"
    iptablesw -t nat -X "$Z2K_IPT_NAT_CHAIN"
}
# ==============================================================================
# PASSIVE DPI FILTER: drop TCP RST packets injected by TSPU/DPI
# TSPU injects fake RST packets with IP ID in range 0x0000-0x000F.
# These arrive BEFORE the real server response and kill the connection.
# Dropping them lets the real response through.
# Enable: DROP_DPI_RST=1 in /opt/zapret2/config
# ==============================================================================

Z2K_RST_CHAIN="z2k_dpi_rst"

z2k_rst_filter_start()
{
    [ "$DROP_DPI_RST" = "1" ] || return 0
    echo "Enabling passive DPI RST filter (IP ID 0x0-0xF)"

    # Check u32 module availability
    iptables -m u32 -h >/dev/null 2>&1 || {
        echo "WARN: xt_u32 module not available, RST filter disabled"
        return 1
    }

    # Create dedicated chain (idempotent)
    iptables -t raw -N "$Z2K_RST_CHAIN" 2>/dev/null || iptables -t raw -F "$Z2K_RST_CHAIN"

    # Match TCP RST where IP Identification field (offset 4, 2 bytes) is 0x0000-0x000F
    # IP header byte 4-5 = Identification field
    # u32 expression: "0>>22&0xFFFF=0x0:0xF" means: word at offset 0, shift right 22 bits (not needed)
    # Actually: offset 4 in IP header = 2nd 32-bit word, upper 16 bits
    # u32: "4&0xFFFF0000=0x0:0xF0000" or simpler via "0>>16&0xFFFF@0>>16&0xFFFF"
    # Simplest: match raw bytes at offset 4-5
    iptables -t raw -A "$Z2K_RST_CHAIN" -p tcp --tcp-flags RST RST \
        -m u32 --u32 "4&0xFFFF0000=0x00000000:0x000F0000" \
        -j DROP

    # Hook into PREROUTING (incoming packets)
    iptables -t raw -C PREROUTING -j "$Z2K_RST_CHAIN" 2>/dev/null || \
        iptables -t raw -A PREROUTING -j "$Z2K_RST_CHAIN"

    echo "Passive DPI RST filter active"
}

z2k_rst_filter_stop()
{
    # Remove hook
    while iptables -t raw -C PREROUTING -j "$Z2K_RST_CHAIN" 2>/dev/null; do
        iptables -t raw -D PREROUTING -j "$Z2K_RST_CHAIN" || break
    done
    # Flush and delete chain
    iptables -t raw -F "$Z2K_RST_CHAIN" 2>/dev/null
    iptables -t raw -X "$Z2K_RST_CHAIN" 2>/dev/null
}

# Conntrack tuning so nfqws SEES incoming DPI RSTs (the rotator needs them to
# rotate off a blocked strategy). bol-van auto-sets be_liberal only in
# autohostlist mode (common/linux_fw.sh); we run hostlist, so set it ourselves.
#  - tcp_be_liberal=1: RU DPI sends RST,ACK with a wrong ACK; strict conntrack
#    marks it INVALID and the connbytes rule never passes it to nfqws.
#  - checksum=0: with HW offload the NIC computes the L4 checksum, so the kernel
#    sees a "bad" checksum -> conntrack marks INVALID (S00fix nfqws-keenetic ships).
#  - fastnat=0: the NDM software fastpath (RTCACHE) routes flows PAST conntrack,
#    so on an offloaded flow nfqws gets "ctrack disabled" and SKIPS every desync
#    ("out pos ... beyond range a0-sN") -> YouTube/RKN silently NOT bypassed on
#    the affected device even though nfqws sees its ClientHello. fastnat=0 forces
#    full conntrack so the range/rotator/desync work. This is the layer that
#    `no ppe` (hardware PPE) does NOT clear (proven 2026-06-08).
z2k_conntrack_tune_start()
{
    [ -w /proc/sys/net/netfilter/nf_conntrack_tcp_be_liberal ] && echo 1 > /proc/sys/net/netfilter/nf_conntrack_tcp_be_liberal 2>/dev/null
    [ -w /proc/sys/net/netfilter/nf_conntrack_checksum ] && echo 0 > /proc/sys/net/netfilter/nf_conntrack_checksum 2>/dev/null
    [ -w /proc/sys/net/netfilter/nf_conntrack_fastnat ] && echo 0 > /proc/sys/net/netfilter/nf_conntrack_fastnat 2>/dev/null
    [ -w /proc/sys/net/netfilter/nf_conntrack_fastnat_xfrm ] && echo 0 > /proc/sys/net/netfilter/nf_conntrack_fastnat_xfrm 2>/dev/null
}

z2k_conntrack_tune_stop()
{
    [ -w /proc/sys/net/netfilter/nf_conntrack_tcp_be_liberal ] && echo 0 > /proc/sys/net/netfilter/nf_conntrack_tcp_be_liberal 2>/dev/null
    [ -w /proc/sys/net/netfilter/nf_conntrack_checksum ] && echo 1 > /proc/sys/net/netfilter/nf_conntrack_checksum 2>/dev/null
    [ -w /proc/sys/net/netfilter/nf_conntrack_fastnat ] && echo 1 > /proc/sys/net/netfilter/nf_conntrack_fastnat 2>/dev/null
    [ -w /proc/sys/net/netfilter/nf_conntrack_fastnat_xfrm ] && echo 1 > /proc/sys/net/netfilter/nf_conntrack_fastnat_xfrm 2>/dev/null
}

start_fw()
{
    echo "Applying zapret2 firewall rules"

    # DEBUG: ��������� FWTYPE ����� linux_fwtype
    [ -n "$Z2K_DEBUG" ] && echo "DEBUG: � start_fw() ����� linux_fwtype - FWTYPE='$FWTYPE'"

    # ���������� ��� firewall (iptables/nftables)
    linux_fwtype

    # DEBUG: ��������� FWTYPE ����� linux_fwtype
    [ -n "$Z2K_DEBUG" ] && echo "DEBUG: � start_fw() ����� linux_fwtype - FWTYPE='$FWTYPE'"

    echo "Detected firewall type: $FWTYPE"

    # ������������ ����������� ������� �� common/linux_fw.sh
    z2k_connmark_init
    z2k_conntrack_tune_start
    zapret_apply_firewall
    z2k_policy_connmark_start
    z2k_udp_masquerade_fix_start
    z2k_rst_filter_start

    # Game WARP mode — bring up the usque (MASQUE) tunnel + game-ipset split-tunnel
    # when enabled. Backgrounded so a slow usque registration never stalls the
    # firewall apply; z2k-warp.sh selfheal (scheduler, minute-cadence) is the net.
    if [ "$(grep -m1 '^GAME_WARP_ENABLED=' "${ZAPRET2_DIR:-/opt/zapret2}/config" 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d ' ')" = "1" ] && [ -r "${ZAPRET2_DIR:-/opt/zapret2}/z2k-warp.sh" ]; then
        ( sh "${ZAPRET2_DIR:-/opt/zapret2}/z2k-warp.sh" enable >/dev/null 2>&1 ) &
    fi

    return 0
}

stop_fw()
{
    echo "Removing zapret2 firewall rules"

    # ���������� ��� firewall
    linux_fwtype

    z2k_rst_filter_stop
    # ������������ ����������� �������
    z2k_connmark_init
    z2k_udp_masquerade_fix_stop
    z2k_policy_connmark_stop
    z2k_conntrack_tune_stop
    zapret_unapply_firewall
    z2k_sweep_orphan_nfqueue

    return 0
}

# ------------------------------------------------------------------------------
# Orphaned NFQUEUE rules
# ------------------------------------------------------------------------------
# zapret_unapply_firewall deletes by REBUILDING the rule text from the CURRENT
# WAN interface list, so a rule installed under a different interface set is
# never matched and stays forever. That is not hypothetical: until the
# get_default_ifaces4 fix below, BusyBox `ip route show default` returned every
# LAN bridge as a WAN, so live routers carry NFQUEUE rules on br0/br1. After the
# fix stop_fw only knows about ppp0, so those 12 rules would be stranded - still
# queueing LAN-to-LAN traffic into nfqws2 forever.
#
# Sweep them by OUR queue number only. --queue-num $QNUM is z2k's own; other
# software's NFQUEUE rules use different numbers and are left alone. Rules are
# turned from `-A` into `-D` and fed back, which is exact - no pattern guessing.
z2k_sweep_orphan_nfqueue()
{
    local qn="${QNUM:-200}" save restore fam
    for fam in 4 6; do
        if [ "$fam" = 4 ]; then save=iptables-save; restore=iptables; else save=ip6tables-save; restore=ip6tables; fi
        command -v "$save" >/dev/null 2>&1 || continue
        "$save" -t mangle 2>/dev/null | grep -- "--queue-num $qn" | while IFS= read -r rule; do
            case "$rule" in
                -A*) ;;
                *)   continue ;;
            esac
            # shellcheck disable=SC2086
            $restore -w -t mangle -D ${rule#-A } 2>/dev/null ||                 $restore -t mangle -D ${rule#-A } 2>/dev/null || true
        done
    done
    return 0
}

restart_fw()
{
    stop_fw
    sleep 1
    start_fw
}

# ==============================================================================
# OPTIONAL NFTABLES HELPERS (IF AVAILABLE)
# ==============================================================================

reload_ifsets()
{
    existf zapret_reload_ifsets || {
        echo "reload_ifsets not available (nftables functions not loaded)"
        return 1
    }
    zapret_reload_ifsets
}

list_ifsets()
{
    existf zapret_list_ifsets || {
        echo "list_ifsets not available (nftables functions not loaded)"
        return 1
    }
    zapret_list_ifsets
}

list_table()
{
    existf zapret_list_table || {
        echo "list_table not available (nftables functions not loaded)"
        return 1
    }
    zapret_list_table
}

# ==============================================================================
# �������� ������� START/STOP/RESTART
# ==============================================================================

start()
{
    if [ "$ENABLED" != "1" ]; then
        echo "zapret2 is disabled in config"
        return 1
    fi

    echo "Starting zapret2 service"

    # 1. ��������� ����������� ������ ����
    load_modules || echo "Warning: Some modules failed to load"

    # 2. ��������� firewall �������
    [ "$INIT_APPLY_FW" = "1" ] && start_fw

    # 2.1. ����������� autohostlist ����� (���� ��������)
    ensure_autohostlist_files
    sync_autohostlist_to_rkn

    # 2.2. autocircular cache/debug files: start_daemons() re-runs
    # ensure_autocircular_files immediately before spawning the daemon, and
    # nothing between here and there touches that directory - so this pass was
    # pure duplication. The start_daemons/restart_daemons CLI verbs stay covered
    # by the call inside start_daemons.

    # traffic debug (optional): nfqws2 debug log + tcpdump pcap capture
    ensure_traffic_debug_files
    traffic_debug_prepare
    traffic_debug_enable_nfqws2_log
    traffic_debug_tcpdump_start

    # 3. ��������� daemon ��������
    start_daemons

    # Orchestrator start removed: upstream'овский daemon удалён 2026-05-07.

    echo "zapret2 service started"
    return 0
}

stop()
{
    echo "Stopping zapret2 service"

    traffic_debug_tcpdump_stop
    # Orchestrator stop removed: upstream daemon удалён 2026-05-07.

    # 1. ���������� daemon ��������
    stop_daemons

    # Sync auto-detected domains after runtime updates.
    sync_autohostlist_to_rkn

    # 2. ������� firewall �������
    [ "$INIT_APPLY_FW" = "1" ] && stop_fw

    echo "zapret2 service stopped"
    return 0
}

restart()
{
    stop
    # stop() now waits for the daemon to actually exit, so this is a short settle
    # for the netfilter teardown rather than a blind guess at death latency.
    if z2k_fracsleep_avail; then usleep 200000 2>/dev/null || sleep 1; else sleep 1; fi
    start
}

status()
{
    echo "Checking zapret2 status..."

    # ��������� �������� �� PID ������
    local running=0
    for pidfile in $PIDDIR/nfqws2_*.pid; do
        if [ -f "$pidfile" ]; then
            local PID
            PID=$(cat "$pidfile")
            if kill -0 $PID 2>/dev/null; then
                echo "nfqws2 daemon running (PID $PID)"
                running=$((running + 1))
            else
                echo "Stale PID file: $pidfile"
            fi
        fi
    done

    if [ $running -gt 0 ]; then
        echo "zapret2 is running ($running daemons)"

        # �������� ��������
        echo "Processes:"
        pgrep -af nfqws2

        return 0
    else
        echo "zapret2 is not running"
        return 1
    fi
}

# ==============================================================================
# MAIN
# ==============================================================================

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    start_fw)
        start_fw
        ;;
    stop_fw)
        stop_fw
        ;;
    restart_fw)
        restart_fw
        ;;
    start_daemons)
        start_daemons
        ;;
    stop_daemons)
        stop_daemons
        ;;
    restart_daemons)
        restart_daemons
        ;;
    reload_ifsets)
        reload_ifsets
        ;;
    list_ifsets)
        list_ifsets
        ;;
    list_table)
        list_table
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|start_fw|stop_fw|restart_fw|start_daemons|stop_daemons|restart_daemons|reload_ifsets|list_ifsets|list_table}"
        exit 1
        ;;
esac

exit $?
