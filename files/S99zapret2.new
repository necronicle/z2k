# ==============================================================================
# �������� ������������
# ==============================================================================

# ��������� ������������
. "$ZAPRET_CONFIG"

# DEBUG: ��������� FWTYPE ����� �������� config
[ -n "$Z2K_DEBUG" ] && echo "DEBUG: ����� �������� config - FWTYPE='$FWTYPE'"

# ��������: ������������� ����� � ������ iptables (�������� - �� :)
# std_ports() ���� ������� ��� �������� ipt.sh, �� ����� ���������� ���� ������
# �������� ������� std_ports() ����� �������� config
