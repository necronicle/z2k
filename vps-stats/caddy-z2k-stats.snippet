# Append this block to /etc/caddy/Caddyfile. It is ADDITIVE and isolated:
# it does NOT touch the existing `213.176.74.63.nip.io:8443 -> localhost:8080`
# relay block, nor nginx:443 (the SNI stream router for the relay).
#
# A bare `:8088` site serves plain HTTP (no auto-TLS, no cert) on a dedicated
# port, so the router's curl needs no certificate handling. Only the /stats
# path is proxied to the localhost collector; everything else 404s.

:8088 {
	@stats path /stats /stats/
	handle @stats {
		reverse_proxy 127.0.0.1:9099
	}
	handle {
		respond "z2k" 404
	}
}
