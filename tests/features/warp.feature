  # туннеля теперь решает движок z2k-warpd (status.json, ready=true|false);
  # обвязка обязана ему верить и ничего не предполагать сама. Выдержка «одна
  # осечка не рушит маршрут» переехала в движок (internal/health) и покрыта там.

